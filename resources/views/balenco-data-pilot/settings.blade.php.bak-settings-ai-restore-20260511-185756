<script>
(function () {
    function text(el) { return (el && el.textContent || '').toLowerCase(); }
    function hideFetchCategoryParts() {
        document.querySelectorAll('form, button, a').forEach(function (el) {
            var t = text(el);
            var action = (el.getAttribute('action') || el.getAttribute('href') || '').toLowerCase();
            if ((t.includes('fetch balenco categories') || t.includes('fetch categories') || action.includes('fetch-balenco-categories') || action.includes('fetch-categories'))) {
                if (el.tagName === 'FORM') el.style.display = 'none';
                else el.style.display = 'none';
            }
        });
        document.querySelectorAll('.alert, .bdp-alert, .notice, .message, [role="alert"]').forEach(function (el) {
            var t = text(el);
            if (t.includes('could not fetch') && t.includes('categories')) {
                el.style.display = 'none';
            }
            if (t.includes('ec_product_categories') || t.includes('product_categories') && t.includes('doesn')) {
                el.style.display = 'none';
            }
        });
        document.querySelectorAll('.bdp-card, .card, aside > div').forEach(function (el) {
            var t = text(el);
            if (t.includes('balenco categories') && t.includes('fetch')) {
                // Keep the AI SEO Prompt Settings card if it is inside the same right column; hide only fetch button/forms.
                el.querySelectorAll('button, form, a').forEach(function (child) {
                    var ct = text(child) + ' ' + (child.getAttribute('action') || child.getAttribute('href') || '');
                    if (ct.toLowerCase().includes('fetch')) child.style.display = 'none';
                });
            }
        });
    }
    if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', hideFetchCategoryParts);
    else hideFetchCategoryParts();
})();
</script>
<!-- BDP_HIDE_FETCH_CATEGORIES_END -->

