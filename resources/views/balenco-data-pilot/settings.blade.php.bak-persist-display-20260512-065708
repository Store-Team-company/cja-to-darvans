        allCards.forEach(function(card){
            var key = bdpPanelKey(card);
            if (!panels[key]) key = 'sync';
            panels[key].appendChild(card);
        });

        tabsConfig.forEach(function(item){
            var panel = panels[item.key];
            var tab = tabs.querySelector('[data-tab="' + item.key + '"]');
            if (!panel.children.length && tab) {
                tab.style.display = 'none';
                panel.style.display = 'none';
            }
        });

        function activate(key) {
            Array.from(tabs.querySelectorAll('.bdp-settings-tab')).forEach(function(btn){
                btn.classList.toggle('is-active', btn.dataset.tab === key);
            });
            Array.from(panelsWrap.querySelectorAll('.bdp-settings-tab-panel')).forEach(function(panel){
