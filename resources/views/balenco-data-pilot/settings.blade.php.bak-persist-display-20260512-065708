<script>
(function () {
    function bdpNormalizeText(text) {
        return (text || '').toLowerCase().replace(/\s+/g, ' ').trim();
    }

    function bdpFindMainContainer() {
        var cards = Array.from(document.querySelectorAll('.bdp-card'));
        if (!cards.length) return null;
        var first = cards[0];
        return first.closest('.bdp-content, .bdp-main, main, .container, .page-content') || first.parentElement;
    }

    function bdpCardTitle(card) {
        var title = card.querySelector('.bdp-card-title, h2, h3, h4, .card-title');
        return bdpNormalizeText(title ? title.textContent : card.textContent.slice(0, 120));
    }

    function bdpPanelKey(card) {
        var title = bdpCardTitle(card);

        if (title.includes('connected store') || title.includes('store connection') || title.includes('store domain')) return 'store';
        if (title.includes('sync settings')) return 'sync';
        if (title.includes('ai seo') || title.includes('ai prompt') || title.includes('prompt settings')) return 'ai';
        if (title.includes('pricing default') || title.includes('price default') || title.includes('pricing')) return 'pricing';
        if (title.includes('category') || title.includes('balenco category') || title.includes('optional category')) return 'categories';

        return 'general';
    }

    function bdpInitSettingsTabs() {
        if (document.body.dataset.bdpSettingsTabsReady === '1') return;
        document.body.dataset.bdpSettingsTabsReady = '1';

        var container = bdpFindMainContainer();
        if (!container) return;

        var allCards = Array.from(container.querySelectorAll(':scope > .bdp-card, :scope > form > .bdp-card, .bdp-settings-grid > .bdp-card, .bdp-grid > .bdp-card'));
        if (!allCards.length) {
            allCards = Array.from(document.querySelectorAll('.bdp-card'));
        }

        allCards = allCards.filter(function(card){
            var title = bdpCardTitle(card);
            return title.includes('connected store')
                || title.includes('sync settings')
                || title.includes('pricing')
                || title.includes('ai seo')
                || title.includes('ai prompt')
                || title.includes('category');
        });

        if (allCards.length < 2) return;

        var existing = document.querySelector('.bdp-settings-tabs-shell');
        if (existing) existing.remove();

        var tabsConfig = [
            {key:'store', label:'Connected Store', help:'Store/domain details used when products are pushed.'},
            {key:'sync', label:'Sync Settings', help:'Safe defaults for product sync behavior.'},
            {key:'ai', label:'AI SEO Prompt', help:'Default AI prompt rules and word counts.'},
            {key:'pricing', label:'Pricing Defaults', help:'Margin, minimum price, and rounding settings.'},
