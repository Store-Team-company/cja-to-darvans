            <li><strong>Database host</strong>: MySQL host/IP, not always the website domain.</li>
            <li><strong>Store name</strong>: internal label only, such as Live Store or Sandbox.</li>
            <li><strong>Store domain</strong>: public website URL for reference and previews.</li>
            <li><strong>Store admin/API base URL</strong>: optional; mainly used if you later choose API receiver mode.</li>
            <li><strong>Password field</strong>: stars mean a password is already saved. Leave it as stars to keep the saved password.</li>
        </ul>
        <div class="bdp-settings-modal-actions"><button type="button" class="bdp-settings-modal-close">Close</button></div>
    </div>
</div>
<script>
document.addEventListener('DOMContentLoaded', function () {
    const saved = @json($settings ?? []);

    function setIfEmpty(name, value) {
        if (value === undefined || value === null || value === '') return;
        document.querySelectorAll('[name="' + name + '"]').forEach(function (el) {
            if (!el.value) el.value = value;
        });
    }

    const aliases = {
        store_db_name: saved.store_db_database,
        store_db_user: saved.store_db_username,
        store_table_prefix: saved.store_db_prefix,
        store_admin_api_url: saved.store_api_url,
        store_api_endpoint: saved.store_api_receiver_url
    };

    Object.keys(saved || {}).forEach(function (key) { setIfEmpty(key, saved[key]); });
    Object.keys(aliases).forEach(function (key) { setIfEmpty(key, aliases[key]); });

    ['store_db_password', 'store_api_secret', 'store_api_secret_key'].forEach(function (name) {
        document.querySelectorAll('input[name="' + name + '"]').forEach(function (el) {
            if (!el.value && (saved[name] || saved.store_db_password || saved.store_api_secret)) {
                el.value = '********';
            }
        });
    });

    const pushMethod = document.querySelector('[name="store_push_method"]');
    if (pushMethod && saved.store_push_method) pushMethod.value = saved.store_push_method;
    const storeStatus = document.querySelector('[name="store_status"]');
    if (storeStatus && saved.store_status) storeStatus.value = saved.store_status;

    // Add one Learn more link near Connected Store / Push Connection Method.
    const headings = Array.from(document.querySelectorAll('h2,h3,h4,.bdp-card-title'));
    const heading = headings.find(function (h) {
        return /push connection method|connected store/i.test((h.textContent || '').trim());
    });
    if (heading && !document.getElementById('bdp-settings-learn-more-link')) {
        const link = document.createElement('a');
        link.id = 'bdp-settings-learn-more-link';
        link.className = 'bdp-settings-help-inline';
        link.href = '#';
        link.textContent = 'Learn more';
        heading.appendChild(link);
    }

    document.addEventListener('click', function (e) {
        const open = e.target.closest('#bdp-settings-learn-more-link');
        if (open) {
            e.preventDefault();
            const modal = document.getElementById('bdp-settings-connection-modal');
            if (modal) modal.style.display = 'flex';
        }
        if (e.target.closest('.bdp-settings-modal-close') || e.target.id === 'bdp-settings-connection-modal') {
            const modal = document.getElementById('bdp-settings-connection-modal');
            if (modal) modal.style.display = 'none';
        }
    });

    // Make the status message smarter.
    const statusNotes = Array.from(document.querySelectorAll('*')).filter(function (el) {
        return el.children.length === 0 && /No connected store domain saved yet/i.test(el.textContent || '');
    });
    statusNotes.forEach(function (el) {
        const hasDomain = !!(saved.store_domain || document.querySelector('[name="store_domain"]')?.value);
        const hasDb = !!(saved.store_db_host || document.querySelector('[name="store_db_host"]')?.value);
        if (hasDomain || hasDb) {
            el.textContent = hasDomain ? 'Connected store details are saved.' : 'Database connection details are saved. Add a store domain later for previews.';
            el.style.borderColor = '#bbf7d0';
            el.style.background = '#f0fdf4';
            el.style.color = '#166534';
        }
    });
});
</script>
<!-- BDP_SETTINGS_CLEANUP_SAVED_FIELDS_END -->

@endsection
