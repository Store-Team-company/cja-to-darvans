<script>
(function () {
    function bdpGetCsrfToken() {
        var tokenInput = document.querySelector('input[name="_token"]');
        if (tokenInput && tokenInput.value) return tokenInput.value;
        var meta = document.querySelector('meta[name="csrf-token"]');
        return meta ? meta.getAttribute('content') : '';
    }

    function bdpAppendHidden(form, name, value) {
        var input = document.createElement('input');
        input.type = 'hidden';
        input.name = name;
        input.value = value == null ? '' : value;
        form.appendChild(input);
    }

    function bdpCollectConnectedStoreFields(targetForm) {
        var selectors = [
            'input[name^="store_"]', 'select[name^="store_"]', 'textarea[name^="store_"]',
            'input[name^="connected_store"]', 'select[name^="connected_store"]',
            'input[name^="database_"]', 'select[name^="database_"]',
            'input[name^="db_"]', 'select[name^="db_"]',
            'input[name^="api_"]', 'select[name^="api_"]', 'textarea[name^="api_"]',
            'input[name="domain"]', 'input[name="table_prefix"]', 'input[name="push_method"]', 'select[name="push_method"]'
        ];

        var seen = {};
        document.querySelectorAll(selectors.join(',')).forEach(function (field) {
            if (!field.name || seen[field.name]) return;
            seen[field.name] = true;

            if ((field.type === 'checkbox' || field.type === 'radio') && !field.checked) return;
            bdpAppendHidden(targetForm, field.name, field.value || '');
        });
    }

    document.addEventListener('click', function (event) {
        var btn = event.target.closest('#bdp-save-connected-store');
        if (!btn) return;

        event.preventDefault();

        var form = document.createElement('form');
        form.method = 'POST';
        form.action = "{{ route('bdp.settings.connected-store.save') }}";
        form.style.display = 'none';

        bdpAppendHidden(form, '_token', bdpGetCsrfToken());
        bdpCollectConnectedStoreFields(form);

        document.body.appendChild(form);
        form.submit();
    });
})();
</script>
