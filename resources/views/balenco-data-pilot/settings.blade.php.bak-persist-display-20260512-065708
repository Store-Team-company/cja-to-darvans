<script>
document.addEventListener('DOMContentLoaded', function () {
    const methodSelect = document.getElementById('bdp-store-push-method');
    const dbPanel = document.getElementById('bdp-direct-db-settings');
    const apiPanel = document.getElementById('bdp-api-settings');
    const testBtn = document.getElementById('bdp-test-store-connection');
    const resultBox = document.getElementById('bdp-store-test-result');

    function toggleStoreMethodPanels() {
        const method = methodSelect ? methodSelect.value : 'database';
        if (dbPanel) dbPanel.style.display = method === 'database' ? 'block' : 'none';
        if (apiPanel) apiPanel.style.display = method === 'api' ? 'block' : 'none';
    }

    if (methodSelect) {
        methodSelect.addEventListener('change', toggleStoreMethodPanels);
        toggleStoreMethodPanels();
    }

    function collectSettingsPayload() {
        const payload = {};
        document.querySelectorAll('input[name], select[name], textarea[name]').forEach(function (field) {
            if (field.type === 'checkbox') {
                payload[field.name] = field.checked ? '1' : '0';
            } else {
                payload[field.name] = field.value || '';
            }
        });
        return payload;
    }

    if (testBtn) {
        testBtn.addEventListener('click', function (event) {
            event.preventDefault();
            if (!resultBox) return;

            resultBox.textContent = 'Testing connection...';
            resultBox.style.color = '#475569';
            testBtn.disabled = true;

            const payload = collectSettingsPayload();
            payload._token = document.querySelector('input[name="_token"]')?.value || '{{ csrf_token() }}';

            fetch('{{ route('bdp.settings.test-store') }}', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json',
                    'Accept': 'application/json',
                    'X-CSRF-TOKEN': payload._token
                },
                body: JSON.stringify(payload)
            })
            .then(function (response) { return response.json(); })
            .then(function (data) {
                resultBox.textContent = data.message || (data.ok ? 'Connection successful.' : 'Connection failed.');
                resultBox.style.color = data.ok ? '#15803d' : '#b91c1c';
            })
            .catch(function (error) {
                resultBox.textContent = 'Connection test failed: ' + error.message;
                resultBox.style.color = '#b91c1c';
            })
            .finally(function () {
                testBtn.disabled = false;
            });
        });
    }
});
</script>
