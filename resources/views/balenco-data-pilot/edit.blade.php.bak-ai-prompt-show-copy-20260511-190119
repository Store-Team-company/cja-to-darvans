<script id="BDP_COPY_PROMPT_HIDE_SAFE_FIX">
document.addEventListener('DOMContentLoaded', function () {
    var copyBtn = document.getElementById('bdp-copy-ai-prompt') || document.querySelector('[data-bdp-copy-prompt]');
    var promptBox = document.getElementById('bdp-ai-generated-prompt') || document.querySelector('textarea[id*="generated"][id*="prompt"], textarea[id*="ai"][id*="prompt"]');

    if (!copyBtn || !promptBox) return;

    copyBtn.addEventListener('click', async function () {
        var text = promptBox.value || '';
        if (!text.trim()) return;

        try {
            await navigator.clipboard.writeText(text);
        } catch (e) {
            promptBox.focus();
            promptBox.select();
            document.execCommand('copy');
        }

        var wrap = promptBox.closest('.bdp-ai-prompt-wrap, .bdp-form-group, .form-group, .mb-3, div');
        if (wrap) wrap.style.setProperty('display', 'none', 'important');

        var oldText = copyBtn.textContent;
        copyBtn.textContent = 'Copied';
        setTimeout(function () { copyBtn.textContent = oldText || 'Copy Prompt'; }, 1200);
    });
});
</script>
