        else fn();
    }

    ready(function () {
        const card = document.getElementById('variations');
        if (!card) return;

        // Find the header. In this edit page, the first child is the variations header/summary row.
        const header = card.firstElementChild || card;

        // Remove all previous variation toggle buttons created by older patches.
        card.querySelectorAll('button, a').forEach(function (el) {
            const txt = (el.textContent || '').trim().toLowerCase();
            const isVariationToggle = txt === 'show variations' || txt === 'hide variations' ||
                el.matches('[data-bdp-vars-toggle], [data-bdp-variation-toggle], #bdp-final-variation-toggle, .bdp-vars-final-toggle');
