<script>
document.addEventListener('DOMContentLoaded', function () {
    // Active sticky tabs while scrolling
    const tabs = Array.from(document.querySelectorAll('.bdp-section-tabs a[href^="#"]'));
    const sections = tabs.map(a => document.querySelector(a.getAttribute('href'))).filter(Boolean);
    function setActiveTab() {
        let active = sections[0] ? sections[0].id : null;
        const offset = 160;
        sections.forEach(section => {
            const rect = section.getBoundingClientRect();
            if (rect.top <= offset) active = section.id;
        });
        tabs.forEach(a => a.classList.toggle('is-active', a.getAttribute('href') === '#' + active));
    }
    if (tabs.length) {
        window.addEventListener('scroll', setActiveTab, { passive: true });
        setActiveTab();
        tabs.forEach(a => {
            a.addEventListener('click', function () {
                const target = document.querySelector(a.getAttribute('href'));
                if (target && target.id === 'variations') {
                    setTimeout(() => window.bdpSetVariationsOpen && window.bdpSetVariationsOpen(true), 80);
                }
            });
        });
    }

    // Collapse AI SEO Tools by default, but keep product preview/checklist/sync actions visible.
    const cards = Array.from(document.querySelectorAll('.bdp-edit-side .bdp-card'));
    cards.forEach(function(card) {
        const titleEl = card.querySelector('.bdp-card-title, h2, h3');
        if (!titleEl) return;
        const title = (titleEl.textContent || '').trim();
        if (!/AI SEO Tools/i.test(title)) return;
        if (card.dataset.bdpCompactReady === '1') return;
        card.dataset.bdpCompactReady = '1';
        card.classList.add('bdp-compact-card', 'is-collapsed');

        const header = titleEl.closest('.bdp-card-header') || titleEl.parentElement;
        if (!header) return;

        const body = document.createElement('div');
        body.className = 'bdp-compact-card-body';
        let node = header.nextSibling;
        const moving = [];
        while (node) {
            const next = node.nextSibling;
            moving.push(node);
            node = next;
        }
        moving.forEach(n => body.appendChild(n));
        card.appendChild(body);

        const button = document.createElement('button');
        button.type = 'button';
        button.className = 'bdp-compact-card-toggle';
        button.innerHTML = '<span>' + header.innerHTML + '</span><span class="chev">⌄</span>';
        header.innerHTML = '';
        header.appendChild(button);
        button.addEventListener('click', function () {
            card.classList.toggle('is-collapsed');
        });
    });

    // Ensure details cards like Source & Image Debug start collapsed unless the user opens them.
    document.querySelectorAll('.bdp-edit-side details.bdp-side-collapsible').forEach(function(details){
        if (!details.dataset.userOpened) details.removeAttribute('open');
    });

    // Force variations collapsed by default and show only one toggle button at a time.
    const varCard = document.getElementById('variations');
    if (varCard) {
        const storageKey = 'bdp-edit-variations-open-v3';
        let header = varCard.querySelector('.bdp-card-header') || varCard.firstElementChild;
        let body = varCard.querySelector('.bdp-vars-collapsible-body');
        if (!body) {
            body = document.createElement('div');
            body.className = 'bdp-vars-collapsible-body';
            let startAfter = header || null;
            let node = startAfter ? startAfter.nextSibling : varCard.firstChild;
            const moving = [];
            while (node) {
                const next = node.nextSibling;
                moving.push(node);
                node = next;
            }
            moving.forEach(n => body.appendChild(n));
            varCard.appendChild(body);
        }

        let toggleWrap = varCard.querySelector('.bdp-vars-toggle-wrap');
        if (!toggleWrap) {
            toggleWrap = document.createElement('div');
            toggleWrap.className = 'bdp-vars-toggle-wrap';
            if (header) header.appendChild(toggleWrap);
        }

        // Remove duplicate old buttons by text to avoid two visible controls.
        Array.from(toggleWrap.querySelectorAll('button')).forEach(btn => btn.remove());
        Array.from(varCard.querySelectorAll('button')).forEach(btn => {
            const txt = (btn.textContent || '').trim().toLowerCase();
            if ((txt === 'show variations' || txt === 'hide variations') && !btn.closest('.bdp-vars-toggle-wrap')) btn.remove();
        });

        const showBtn = document.createElement('button');
        showBtn.type = 'button';
        showBtn.className = 'bdp-btn light bdp-vars-show-btn';
        showBtn.textContent = 'Show variations';
        const hideBtn = document.createElement('button');
        hideBtn.type = 'button';
        hideBtn.className = 'bdp-btn light bdp-vars-hide-btn';
        hideBtn.textContent = 'Hide variations';
        toggleWrap.appendChild(hideBtn);
        toggleWrap.appendChild(showBtn);

        window.bdpSetVariationsOpen = function(open) {
            varCard.classList.toggle('bdp-vars-collapsed', !open);
            try { localStorage.setItem(storageKey, open ? '1' : '0'); } catch(e) {}
        };

        showBtn.addEventListener('click', () => window.bdpSetVariationsOpen(true));
        hideBtn.addEventListener('click', () => window.bdpSetVariationsOpen(false));

        let shouldOpen = false;
        try { shouldOpen = localStorage.getItem(storageKey) === '1'; } catch(e) {}
        window.bdpSetVariationsOpen(shouldOpen);
    }
});
</script>
