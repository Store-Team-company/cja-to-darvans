    }

    function getBodyChildren(card, header) {
        return Array.from(card.children).filter(function (child) {
            return child !== header;
        });
    }

    function initVariationsToggle() {
        var card = findVariationsCard();
        if (!card || card.dataset.bdpVarsToggleFixed === '1') return;
        card.dataset.bdpVarsToggleFixed = '1';

        var header = findHeader(card);
        if (!header) return;

        var headerActions = header.querySelector('.bdp-card-actions, .bdp-list-header-actions, .bdp-actions') || header;

        // Remove duplicate old show/hide buttons inside the variations card header only.
        Array.from(header.querySelectorAll('button, a')).forEach(function (btn) {
            var text = (btn.textContent || '').trim().toLowerCase();
            if (text === 'show variations' || text === 'hide variations') {
                btn.remove();
            }
        });

        var btn = document.createElement('button');
        btn.type = 'button';
        btn.className = 'bdp-btn light bdp-variation-toggle-fixed';
        btn.setAttribute('data-bdp-variation-toggle-fixed', '1');
        headerActions.appendChild(btn);

        var bodyChildren = getBodyChildren(card, header);

        function setExpanded(expanded) {
            bodyChildren.forEach(function (child) {
                child.style.display = expanded ? '' : 'none';
            });
            btn.textContent = expanded ? 'Hide variations' : 'Show variations';
            card.dataset.variationsExpanded = expanded ? '1' : '0';
        }

        // Always start collapsed on product edit pages.
        setExpanded(false);

        btn.addEventListener('click', function () {
            setExpanded(card.dataset.variationsExpanded !== '1');
        });

        // If top sticky/tab navigation clicks Variations, open it automatically.
        Array.from(document.querySelectorAll('a, button')).forEach(function (nav) {
            var text = (nav.textContent || '').trim().toLowerCase();
            var href = nav.getAttribute('href') || '';
            if (text === 'variations' || href === '#variations') {
                nav.addEventListener('click', function () {
                    setExpanded(true);
                    setTimeout(function () { card.scrollIntoView({ behavior: 'smooth', block: 'start' }); }, 50);
                });
            }
        });
    }

    document.addEventListener('DOMContentLoaded', function () {
        initVariationsToggle();
        setTimeout(initVariationsToggle, 400);
        setTimeout(initVariationsToggle, 1000);
    });
    window.addEventListener('load', function () {
        setTimeout(initVariationsToggle, 300);
    });
})();
</script>
