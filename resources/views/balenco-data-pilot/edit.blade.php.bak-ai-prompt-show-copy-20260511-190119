{{-- BDP sticky edit section tabs active state --}}

<script>
document.addEventListener('DOMContentLoaded', function () {
    const tabs = Array.from(document.querySelectorAll('.bdp-section-tabs a[href^="#"]'));
    const sections = tabs.map(function (tab) {
        const id = tab.getAttribute('href');
        return id ? document.querySelector(id) : null;
    }).filter(Boolean);

    if (!tabs.length || !sections.length) return;

    function setActive() {
        let activeId = sections[0].id;
        const offset = 130;
        sections.forEach(function (section) {
            const rect = section.getBoundingClientRect();
            if (rect.top <= offset) activeId = section.id;
        });
        tabs.forEach(function (tab) {
            tab.classList.toggle('is-active', tab.getAttribute('href') === '#' + activeId);
        });
    }

    tabs.forEach(function (tab) {
        tab.addEventListener('click', function (event) {
            const target = document.querySelector(tab.getAttribute('href'));
            if (!target) return;
            event.preventDefault();
            const top = target.getBoundingClientRect().top + window.pageYOffset - 118;
            window.scrollTo({ top: top, behavior: 'smooth' });
            history.replaceState(null, '', tab.getAttribute('href'));
            setTimeout(setActive, 250);
        });
    });

    window.addEventListener('scroll', setActive, { passive: true });
    setActive();
});
</script>


