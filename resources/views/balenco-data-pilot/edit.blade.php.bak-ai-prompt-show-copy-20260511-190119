            + 'Important rules:\n'
            + '- Use only the product facts provided.\n'
            + '- Do not invent materials, comfort claims, medical claims, waterproof claims, warranty claims, shipping promises, or brand claims.\n'
            + '- Do not mention supplier names, CJ, CJDropshipping, AliExpress, Alibaba, warehouse, factory, source product ID, or supplier SKU prefixes.\n'
            + '- Do not expose supplier SKU prefixes in public slugs. If SKU contains CJ/CJNS, convert the numeric part to a safe b-suffix, e.g. CJNS1274506 becomes b1274506.\n'
            + '- Use American English. Write for real ecommerce buyers first, SEO second. Avoid keyword stuffing.\n\n'
            + 'Output rules:\n'
            + '- Short description words: '+d.ai_short_words+'\n'
            + '- Long description words: '+d.ai_long_words+'\n'
            + '- Meta description characters: '+d.ai_meta_chars+'\n'
            + '- Tags count: '+d.ai_tags_count+'\n'
            + '- Buyer intent: '+selectedBuyerIntent()+'\n\n'
            + 'Product data:\n'
            + 'Title: '+title+'\n'
            + 'Slug: '+slug+'\n'
            + 'SKU: '+sku+'\n'
            + 'Categories: '+categories+'\n'
            + 'Tags: '+tags+'\n'
            + 'SEO title: '+seoTitle+'\n'
            + 'SEO description: '+seoDescription+'\n'
            + 'Short description: '+shortDescription+'\n'
            + 'Long description: '+longDescription+'\n\n'
            + 'Return only valid JSON in this exact format:\n'
            + '{"title":"","slug":"","short_description":"","long_description":"","focus_keyword":"","seo_title":"","seo_description":"","tags":[]}';
    }

    function showPromptBox(){
        var box = ensurePromptBox();
        var wrap = box.closest('.bdp-ai-prompt-wrap') || box.parentElement;
        if (wrap) wrap.style.display = 'block';
        return box;
    }

    async function copyText(text){
        if (navigator.clipboard && window.isSecureContext) {
            await navigator.clipboard.writeText(text);
            return;
        }
        var temp = document.createElement('textarea');
        temp.value = text;
        document.body.appendChild(temp);
        temp.select();
        document.execCommand('copy');
        temp.remove();
    }

    document.addEventListener('click', async function(e){
        var buildBtn = e.target.closest('#bdp-build-ai-prompt') || (e.target.closest('button,a') && (e.target.closest('button,a').textContent || '').trim().toLowerCase() === 'build ai prompt' ? e.target.closest('button,a') : null);
        if (buildBtn) {
            e.preventDefault();
            var box = showPromptBox();
            box.value = buildPromptText();
            return;
        }

        var copyBtn = e.target.closest('#bdp-copy-ai-prompt') || (e.target.closest('button,a') && (e.target.closest('button,a').textContent || '').trim().toLowerCase() === 'copy prompt' ? e.target.closest('button,a') : null);
        if (copyBtn) {
            e.preventDefault();
            var pbox = ensurePromptBox();
            if (!pbox.value.trim()) pbox.value = buildPromptText();
            try { await copyText(pbox.value); } catch(err) { console.warn(err); }
            var wrap = pbox.closest('.bdp-ai-prompt-wrap') || pbox.parentElement;
            if (wrap) wrap.style.display = 'none';
            var old = copyBtn.textContent;
            copyBtn.textContent = 'Copied';
            setTimeout(function(){ copyBtn.textContent = old || 'Copy Prompt'; }, 1200);
        }
    }, true);

    document.addEventListener('DOMContentLoaded', function(){
        var box = ensurePromptBox();
        var wrap = box.closest('.bdp-ai-prompt-wrap') || box.parentElement;
        if (wrap) wrap.style.display = 'none';
    });
})();
</script>
