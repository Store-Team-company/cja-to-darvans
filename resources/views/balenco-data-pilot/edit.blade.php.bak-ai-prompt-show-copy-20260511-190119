<script>
(function () {
    function initBdpQuillEditors() {
        var fields = document.querySelectorAll('textarea.bdp-rich-editor');
        if (!fields.length) return;

        if (!window.Quill) {
            console.error('BDP editor: Quill failed to load. Textareas are still available.');
            fields.forEach(function (textarea) { textarea.style.display = ''; });
            return;
        }

        fields.forEach(function (textarea, index) {
            if (textarea.dataset.quillReady === '1') return;
            textarea.dataset.quillReady = '1';

            if (!textarea.id) textarea.id = 'bdp-rich-editor-' + index;

            var wrapper = document.createElement('div');
            wrapper.className = 'bdp-quill-wrapper' + (textarea.name === 'content' ? ' bdp-quill-large' : '');

            var editorEl = document.createElement('div');
            editorEl.id = textarea.id + '-quill';
            wrapper.appendChild(editorEl);

            textarea.style.display = 'none';
            textarea.parentNode.insertBefore(wrapper, textarea.nextSibling);

            var quill = new Quill(editorEl, {
                theme: 'snow',
                modules: {
                    toolbar: [
                        [{ header: [2, 3, 4, false] }],
                        ['bold', 'italic', 'underline'],
                        [{ list: 'ordered' }, { list: 'bullet' }],
                        ['link'],
                        ['blockquote', 'code-block'],
                        ['clean']
                    ]
                }
            });

            var initialHtml = textarea.value || '';
            if (initialHtml.trim()) {
                quill.clipboard.dangerouslyPasteHTML(initialHtml);
            }

            function syncTextarea() {
                textarea.value = quill.root.innerHTML;
                textarea.dispatchEvent(new Event('input', { bubbles: true }));
            }

            quill.on('text-change', syncTextarea);
            syncTextarea();
        });

        document.querySelectorAll('form').forEach(function (form) {
            if (form.dataset.quillSubmitBound === '1') return;
            form.dataset.quillSubmitBound = '1';
            form.addEventListener('submit', function () {
                document.querySelectorAll('textarea.bdp-rich-editor').forEach(function (textarea) {
                    var editor = document.querySelector('#' + textarea.id + '-quill .ql-editor');
                    if (editor) textarea.value = editor.innerHTML;
                });
            });
        });
    }

    if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', initBdpQuillEditors);
    } else {
        initBdpQuillEditors();
    }
})();
</script>



{{-- BDP AI SEO Tools Patch: prompt builder + JSON apply helper --}}
<script>
(function () {
    function qs(selector) { return document.querySelector(selector); }
    function qsa(selector) { return Array.from(document.querySelectorAll(selector)); }
    function getValue(selector) {
        const el = qs(selector);
        return el ? (el.value || '').trim() : '';
    }
    function setValue(selector, value) {
        const el = qs(selector);
        if (!el || value === undefined || value === null) return;
        el.value = value;
        el.dispatchEvent(new Event('input', { bubbles: true }));
        el.dispatchEvent(new Event('change', { bubbles: true }));
    }
    function richTextareas() {
        return qsa('textarea.bdp-rich-editor');
    }
    function getRichValueByName(name) {
        const textarea = qs('textarea[name="' + name + '"]');
        if (!textarea) return '';
        const list = richTextareas();
        const index = list.indexOf(textarea);
        const editors = qsa('.ql-editor');
        if (index >= 0 && editors[index]) return editors[index].innerHTML.trim();
        return textarea.value.trim();
    }
    function setRichValueByName(name, value) {
        if (value === undefined || value === null) return;
        const textarea = qs('textarea[name="' + name + '"]');
        if (!textarea) return;
        textarea.value = value;
        textarea.dispatchEvent(new Event('input', { bubbles: true }));
        textarea.dispatchEvent(new Event('change', { bubbles: true }));
        const list = richTextareas();
        const index = list.indexOf(textarea);
        const editors = qsa('.ql-editor');
        if (index >= 0 && editors[index]) editors[index].innerHTML = value;
    }
    function status(message, type) {
        const box = qs('#bdp-ai-status');
        if (!box) return;
        box.className = 'bdp-ai-mini-status ' + (type || 'ok');
        box.textContent = message;
    }
    function slugify(text) {
        return (text || '').toString().toLowerCase()
            .replace(/&/g, ' and ')
            .replace(/[^a-z0-9]+/g, '-')
            .replace(/^-+|-+$/g, '')
            .substring(0, 90);
    }
    function collectVariations() {
        return qsa('.bdp-variation-table tbody tr').slice(0, 30).map(function(row) {
            const inputs = row.querySelectorAll('input, select');
            return {
                image: inputs[1] ? inputs[1].value : '',
                color: inputs[2] ? inputs[2].value : '',
                raw_size: inputs[3] ? inputs[3].value : '',
                us_size: inputs[4] ? inputs[4].value : '',
                selling_price: inputs[5] ? inputs[5].value : '',
                quantity: inputs[6] ? inputs[6].value : '',
                stock_status: inputs[7] ? inputs[7].value : ''
            };
        }).filter(function(v) { return v.color || v.us_size || v.raw_size; });
    }
    function getAiSetting(selector, fallback) {
        const el = qs(selector);
        return el && el.value ? el.value.trim() : fallback;
    }
    function skuToBalencoSlugCode(sku) {
        const raw = (sku || '').toString().trim();
        const digits = raw.replace(/^CJ[A-Z]*/i, '').replace(/[^0-9]/g, '');
        return digits ? ('b' + digits) : '';
    }
    function buildPrompt() {
        const sku = getValue('input[name="sku"]');
        const product = {
            current_title: getValue('input[name="name"]'),
            current_slug: getValue('input[name="slug"]'),
            sku: sku,
            balenco_slug_code: skuToBalencoSlugCode(sku),
            categories: getValue('input[name="categories"]'),
            tags: getValue('input[name="tags"]'),
            price: getValue('input[name="price"]'),
            sale_price: getValue('input[name="sale_price"]'),
            focus_keyword: getValue('input[name="focus_keyword"]'),
            seo_title: getValue('input[name="seo_title"]'),
            seo_description: getValue('textarea[name="seo_description"]'),
            short_description: getRichValueByName('short_description'),
            long_description: getRichValueByName('content'),
            featured_image: getValue('input[name="featured_image"]'),
            variations_sample: collectVariations()
        };

        const promptSettings = {
            short_description_words: getAiSetting('#bdp-ai-short-words', '40–60'),
            long_description_words: getAiSetting('#bdp-ai-long-words', '180–230'),
            meta_description_chars: getAiSetting('#bdp-ai-meta-chars', '150–160'),
            tags_count: getAiSetting('#bdp-ai-tags-count', '6'),
            buyer_intent: getAiSetting('#bdp-ai-buyer-intent', 'Everyday wear'),
            target_market: 'USA',
            store_brand: 'Balenco'
        };

        return `Act as a senior ecommerce SEO strategist, product content writer, and CRO expert for Balenco, a women's footwear store targeting USA buyers.

Your task is to rewrite and optimize this product listing for Google SEO, buyer intent, and conversion.

IMPORTANT CONTENT RULES:
- Use only the product facts provided in the product data.
- Do not invent materials, comfort claims, orthopedic/medical claims, waterproof claims, genuine leather claims, premium/luxury claims, shipping promises, guarantees, or brand claims.
- Do not mention CJ, CJDropshipping, supplier IDs, supplier names, supplier SKU prefixes, factory language, or raw marketplace wording in customer-facing content.
- Do not use keyword stuffing.
- Use American English.
- Target real buyers first, search engines second.
- Make the content natural, clean, readable, and suitable for a women’s footwear ecommerce store.
- If any product fact is unclear, keep the wording general and safe.

SLUG RULE:
- Create a short, clean, SEO-friendly URL slug.
- Do not use CJ, CJNS, CJBH, CJD, supplier prefixes, or the full supplier SKU in the slug.
- If SKU/source SKU contains a CJ-style code such as CJNS1274506, remove the CJ/CJNS prefix and append b + number at the end.
- Example: CJNS1274506 becomes b1274506.
- Example final slug: womens-light-green-stiletto-pumps-b1274506.
- For this product, use this slug ending if available: ${product.balenco_slug_code || 'b + numeric part of SKU'}.

BUYER INTENT:
${promptSettings.buyer_intent}

REQUIRED OUTPUT:
Return ONLY valid JSON with these exact keys:
{
  "title": "",
  "slug": "",
  "short_description": "",
  "description": "",
  "seo_title": "",
  "seo_description": "",
  "focus_keyword": "",
  "tags": ""
}

LENGTH AND FORMAT RULES:
- Title: clear, buyer-friendly, under 70 characters if possible.
- Short description: ${promptSettings.short_description_words} words, benefit-focused, clean HTML allowed.
- Long description: ${promptSettings.long_description_words} words, clean HTML only using <p>, <ul>, <li>, <strong>. Remove messy imported HTML wrappers.
- SEO title: under 60 characters if possible.
- SEO description: ${promptSettings.meta_description_chars} characters, natural and click-focused.
- Tags: exactly ${promptSettings.tags_count} comma-separated tags. Do not repeat the same phrase in every tag.
- Focus keyword: one natural buyer-intent phrase.

PRODUCT DATA:
${JSON.stringify(product, null, 2)}`;
    }
    

    function applyAiJson() {
        const raw = getValue('#bdp-ai-json-output');
        if (!raw) {
            status('Paste AI JSON output first.', 'warn');
            return;
        }
        let data;
        try {
            data = JSON.parse(raw);
        } catch (e) {
            status('Invalid JSON. Ask AI to return only valid JSON.', 'err');
            return;
        }

        if (data.title) setValue('input[name="name"]', data.title);
        if (data.slug) setValue('input[name="slug"]', slugify(data.slug));
        if (data.short_description) setRichValueByName('short_description', data.short_description);
        if (data.description) setRichValueByName('content', data.description);
        if (data.seo_title) setValue('input[name="seo_title"]', data.seo_title);
        if (data.seo_description) setValue('textarea[name="seo_description"]', data.seo_description);
        if (data.focus_keyword) setValue('input[name="focus_keyword"]', data.focus_keyword);
        if (data.tags) setValue('input[name="tags"]', Array.isArray(data.tags) ? data.tags.join(', ') : data.tags);

        status('AI output applied. Review carefully, then click Save Product.', 'ok');
    }

    function initAiSeoTools() {
        const buildBtn = qs('#bdp-ai-build-prompt');
        const copyBtn = qs('#bdp-ai-copy-prompt');
        const applyBtn = qs('#bdp-ai-apply-json');
        const clearBtn = qs('#bdp-ai-clear-json');
        const promptBox = qs('#bdp-ai-prompt-box');
        const promptOut = qs('#bdp-ai-prompt-output');
        const jsonOut = qs('#bdp-ai-json-output');

        if (buildBtn) buildBtn.addEventListener('click', function () {
            if (!promptOut) return;
            promptOut.value = buildPrompt();
            if (promptBox) promptBox.classList.add('is-open');
            status('Prompt built. Copy it into ChatGPT, then paste the JSON response below.', 'ok');
        });
        if (copyBtn) copyBtn.addEventListener('click', async function () {
            const prompt = promptOut && promptOut.value ? promptOut.value : buildPrompt();
            if (promptOut) promptOut.value = prompt;
            if (promptBox) promptBox.classList.add('is-open');
            try {
                await navigator.clipboard.writeText(prompt);
                status('Prompt copied to clipboard.', 'ok');
            } catch (e) {
                status('Prompt ready. Select and copy it manually.', 'warn');
            }
        });
        if (applyBtn) applyBtn.addEventListener('click', applyAiJson);
        if (clearBtn) clearBtn.addEventListener('click', function () {
            if (jsonOut) jsonOut.value = '';
            status('AI output box cleared.', 'ok');
        });
    }

    if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', initAiSeoTools);
    } else {
        initAiSeoTools();
    }
})();
</script>



<script>
(function () {
