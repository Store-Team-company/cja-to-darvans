        transform:translateY(-1px);
    }
    .bdp-settings-tab-btn.is-active{
        background:#0f172a;
        border-color:#0f172a;
        color:#fff;
        box-shadow:0 8px 20px rgba(15,23,42,.15);
    }
    .bdp-settings-tab-panel{display:none!important;}
    .bdp-settings-tab-panel.is-active{display:block!important;}
    .bdp-settings-tab-panel.is-active.bdp-settings-grid-card{display:block!important;}
    .bdp-settings-tab-helper{
        margin:0 0 16px;
        color:#64748b;
        font-size:13px;
    }
</style>
<script>
(function(){
    function textOf(el){ return (el && el.textContent ? el.textContent : '').replace(/\s+/g,' ').trim(); }
    function closestCard(el){
        if (!el) return null;
        return el.closest('.bdp-card, .card, .widget, .box, .settings-card, .bdp-settings-card, section, .col-md-12, .col-lg-12') || el.parentElement;
    }
    function findCardByTitle(title){
        var headings = Array.from(document.querySelectorAll('h1,h2,h3,h4,.bdp-card-title,.card-title,strong,label'));
        var h = headings.find(function(el){ return textOf(el).toLowerCase() === title.toLowerCase(); });
        if (!h) {
            h = headings.find(function(el){ return textOf(el).toLowerCase().includes(title.toLowerCase()); });
        }
        return closestCard(h);
    }
    function moveElementIntoPanel(el, panel){
        if (!el || !panel || el.dataset.bdpTabbed === '1') return;
        el.dataset.bdpTabbed = '1';
        el.classList.add('bdp-settings-grid-card');
        panel.appendChild(el);
    }
    function initSettingsTabs(){
        if (document.querySelector('.bdp-settings-tabs-wrap')) return;
        var main = document.querySelector('.bdp-main, main, .bdp-content, .content-wrapper, body');
        var settingsHeading = Array.from(document.querySelectorAll('h1,h2')).find(function(el){ return textOf(el).toLowerCase() === 'settings'; });
        if (!settingsHeading) return;
        var container = settingsHeading.parentElement || main;

        var tabs = [
            {key:'store', label:'Connected Store', titles:['Connected Store']},
            {key:'sync', label:'Sync Settings', titles:['Sync Settings']},
            {key:'ai', label:'AI SEO Prompt', titles:['AI SEO Prompt Settings']},
            {key:'pricing', label:'Pricing Defaults', titles:['Pricing Defaults']},
            {key:'categories', label:'Categories', titles:['Optional Category Sync','Balenco Category Source','Balenco Categories']}
        ];

        var tabWrap = document.createElement('div');
        tabWrap.className = 'bdp-settings-tabs-wrap';
        tabWrap.setAttribute('role','tablist');

        var helper = document.createElement('p');
        helper.className = 'bdp-settings-tab-helper';
        helper.textContent = 'Settings are grouped by workflow. Choose a tab to manage one area at a time.';

        var panelsWrap = document.createElement('div');
        panelsWrap.className = 'bdp-settings-panels-wrap';

        tabs.forEach(function(tab, index){
            var btn = document.createElement('button');
            btn.type = 'button';
            btn.className = 'bdp-settings-tab-btn' + (index === 0 ? ' is-active' : '');
            btn.dataset.tab = tab.key;
            btn.textContent = tab.label;
            tabWrap.appendChild(btn);

            var panel = document.createElement('div');
            panel.className = 'bdp-settings-tab-panel' + (index === 0 ? ' is-active' : '');
            panel.dataset.panel = tab.key;
            panelsWrap.appendChild(panel);

            tab.titles.forEach(function(title){
                var card = findCardByTitle(title);
                moveElementIntoPanel(card, panel);
            });
        });

        container.insertBefore(panelsWrap, settingsHeading.nextSibling);
        container.insertBefore(helper, panelsWrap);
        container.insertBefore(tabWrap, helper);

        tabWrap.addEventListener('click', function(e){
            var btn = e.target.closest('.bdp-settings-tab-btn');
            if (!btn) return;
            var key = btn.dataset.tab;
            tabWrap.querySelectorAll('.bdp-settings-tab-btn').forEach(function(b){ b.classList.toggle('is-active', b === btn); });
            panelsWrap.querySelectorAll('.bdp-settings-tab-panel').forEach(function(panel){ panel.classList.toggle('is-active', panel.dataset.panel === key); });
            try { localStorage.setItem('bdp_settings_active_tab', key); } catch(e) {}
        });

        try {
            var saved = localStorage.getItem('bdp_settings_active_tab');
            if (saved) {
                var savedBtn = tabWrap.querySelector('[data-tab="' + saved + '"]');
                if (savedBtn) savedBtn.click();
            }
        } catch(e) {}
    }
    if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', initSettingsTabs);
    } else {
        initSettingsTabs();
    }
})();
</script>
<!-- BDP_SETTINGS_TABS_JS_FINAL_END -->



{{-- BDP_CONNECTED_STORE_TEST_PATCH_START --}}
<style>
    .bdp-test-store-row{display:flex;gap:10px;align-items:center;flex-wrap:wrap;margin-top:12px}
    .bdp-test-store-result{margin-top:10px;padding:11px 13px;border-radius:12px;font-size:13px;font-weight:700;display:none}
    .bdp-test-store-result.is-ok{display:block;background:#ecfdf5;color:#047857;border:1px solid #bbf7d0}
    .bdp-test-store-result.is-error{display:block;background:#fef2f2;color:#b91c1c;border:1px solid #fecaca}
    .bdp-btn-test-store{background:#0f172a!important;color:#fff!important;border-color:#0f172a!important;transition:all .18s ease}
    .bdp-btn-test-store:hover{background:#ff5a1f!important;border-color:#ff5a1f!important;color:#fff!important;transform:translateY(-1px)}
    .bdp-btn-test-store:active{transform:translateY(0);filter:brightness(.94)}
</style>
<script>
(function () {
    function bdpFindInput(names) {
        for (const name of names) {
            const el = document.querySelector('[name="' + name + '"]');
            if (el) return el;
        }
        return null;
    }

    function bdpFindConnectedStoreCard() {
        const headings = Array.from(document.querySelectorAll('h1,h2,h3,h4,strong,.bdp-card-title'));
        const heading = headings.find(function (el) {
            return (el.textContent || '').trim().toLowerCase().includes('connected store');
        });
        if (!heading) return null;
        return heading.closest('.bdp-card, .card, section, form, div') || heading.parentElement;
    }

    function bdpInstallStoreTestButton() {
        if (document.getElementById('bdp-test-store-connection')) return;

        const domainInput = bdpFindInput([
            'connected_store_domain',
            'store_domain',
            'bdp_store_domain',
            'balenco_store_domain',
            'target_store_domain'
        ]);

        const apiInput = bdpFindInput([
            'connected_store_api_url',
            'store_api_base_url',
            'store_api_url',
            'bdp_store_api_url',
            'target_store_api_url'
        ]);

        if (!domainInput && !apiInput) return;

        const card = bdpFindConnectedStoreCard() || (domainInput || apiInput).closest('.bdp-card, .card, form, div');
        if (!card) return;

        const row = document.createElement('div');
        row.className = 'bdp-test-store-row';
        row.innerHTML = '<button type="button" class="bdp-btn bdp-btn-test-store" id="bdp-test-store-connection">Test Connection</button><span class="bdp-input-help">Checks whether the configured store URL is reachable.</span>';

        const result = document.createElement('div');
        result.className = 'bdp-test-store-result';
        result.id = 'bdp-test-store-result';

        const warning = card.querySelector('.bdp-warning, .bdp-alert, .alert, [class*="warning"], [class*="notice"]');
        if (warning && warning.parentNode) {
            warning.parentNode.insertBefore(row, warning.nextSibling);
            warning.parentNode.insertBefore(result, row.nextSibling);
        } else {
            card.appendChild(row);
            card.appendChild(result);
        }

        row.querySelector('#bdp-test-store-connection').addEventListener('click', async function () {
            const btn = this;
            const oldText = btn.textContent;
            const domain = domainInput ? domainInput.value : '';
            const apiUrl = apiInput ? apiInput.value : '';
            const token = document.querySelector('meta[name="csrf-token"]')?.getAttribute('content') || document.querySelector('input[name="_token"]')?.value || '';

            result.className = 'bdp-test-store-result';
            result.style.display = 'block';
            result.textContent = 'Testing connection...';
            btn.disabled = true;
            btn.textContent = 'Testing...';

            try {
                const response = await fetch('{{ route('bdp.settings.test-store') }}', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json',
                        'Accept': 'application/json',
                        'X-CSRF-TOKEN': token
                    },
                    body: JSON.stringify({
                        store_domain: domain,
                        store_api_base_url: apiUrl
                    })
                });

                const data = await response.json().catch(function () { return {}; });

                if (response.ok && data.ok) {
                    result.className = 'bdp-test-store-result is-ok';
                    result.textContent = data.message || 'Connection successful.';
                } else {
                    result.className = 'bdp-test-store-result is-error';
                    result.textContent = data.message || 'Connection failed. Please check the domain or URL.';
                }
            } catch (error) {
                result.className = 'bdp-test-store-result is-error';
                result.textContent = 'Connection failed: ' + (error.message || 'network error');
            } finally {
                btn.disabled = false;
                btn.textContent = oldText;
            }
        });
    }

    if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', bdpInstallStoreTestButton);
    } else {
        bdpInstallStoreTestButton();
    }
})();
</script>
{{-- BDP_CONNECTED_STORE_TEST_PATCH_END --}}

@endsection
