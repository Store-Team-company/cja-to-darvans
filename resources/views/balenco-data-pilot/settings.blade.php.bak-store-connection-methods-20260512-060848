<script>
(function () {
    function bdpNormalizeText(text) {
        return (text || '').toLowerCase().replace(/\s+/g, ' ').trim();
    }

    function bdpFindMainContainer() {
        var cards = Array.from(document.querySelectorAll('.bdp-card'));
        if (!cards.length) return null;
        var first = cards[0];
        return first.closest('.bdp-content, .bdp-main, main, .container, .page-content') || first.parentElement;
    }

    function bdpCardTitle(card) {
        var title = card.querySelector('.bdp-card-title, h2, h3, h4, .card-title');
        return bdpNormalizeText(title ? title.textContent : card.textContent.slice(0, 120));
    }

    function bdpPanelKey(card) {
        var title = bdpCardTitle(card);

        if (title.includes('connected store') || title.includes('store connection') || title.includes('store domain')) return 'store';
        if (title.includes('sync settings')) return 'sync';
        if (title.includes('ai seo') || title.includes('ai prompt') || title.includes('prompt settings')) return 'ai';
        if (title.includes('pricing default') || title.includes('price default') || title.includes('pricing')) return 'pricing';
        if (title.includes('category') || title.includes('balenco category') || title.includes('optional category')) return 'categories';

        return 'general';
    }

    function bdpInitSettingsTabs() {
        if (document.body.dataset.bdpSettingsTabsReady === '1') return;
        document.body.dataset.bdpSettingsTabsReady = '1';

        var container = bdpFindMainContainer();
        if (!container) return;

        var allCards = Array.from(container.querySelectorAll(':scope > .bdp-card, :scope > form > .bdp-card, .bdp-settings-grid > .bdp-card, .bdp-grid > .bdp-card'));
        if (!allCards.length) {
            allCards = Array.from(document.querySelectorAll('.bdp-card'));
        }

        allCards = allCards.filter(function(card){
            var title = bdpCardTitle(card);
            return title.includes('connected store')
                || title.includes('sync settings')
                || title.includes('pricing')
                || title.includes('ai seo')
                || title.includes('ai prompt')
                || title.includes('category');
        });

        if (allCards.length < 2) return;

        var existing = document.querySelector('.bdp-settings-tabs-shell');
        if (existing) existing.remove();

        var tabsConfig = [
            {key:'store', label:'Connected Store', help:'Store/domain details used when products are pushed.'},
            {key:'sync', label:'Sync Settings', help:'Safe defaults for product sync behavior.'},
            {key:'ai', label:'AI SEO Prompt', help:'Default AI prompt rules and word counts.'},
            {key:'pricing', label:'Pricing Defaults', help:'Margin, minimum price, and rounding settings.'},
            {key:'categories', label:'Categories', help:'Optional category source/mapping settings.'}
        ];

        var shell = document.createElement('div');
        shell.className = 'bdp-settings-tabs-shell';

        var tabs = document.createElement('div');
        tabs.className = 'bdp-settings-tabs';

        var help = document.createElement('div');
        help.className = 'bdp-settings-tab-help';

        var panelsWrap = document.createElement('div');
        panelsWrap.className = 'bdp-settings-tab-panels';

        var panels = {};
        tabsConfig.forEach(function(item, index){
            var btn = document.createElement('button');
            btn.type = 'button';
            btn.className = 'bdp-settings-tab' + (index === 0 ? ' is-active' : '');
            btn.dataset.tab = item.key;
            btn.textContent = item.label;
            tabs.appendChild(btn);

            var panel = document.createElement('div');
            panel.className = 'bdp-settings-tab-panel' + (index === 0 ? ' is-active' : '');
            panel.dataset.panel = item.key;
            panels[item.key] = panel;
            panelsWrap.appendChild(panel);
        });

        shell.appendChild(tabs);
        shell.appendChild(help);

        var heading = Array.from(document.querySelectorAll('h1, h2')).find(function(h){
            return bdpNormalizeText(h.textContent) === 'settings';
        });

        if (heading && heading.parentNode) {
            heading.parentNode.insertBefore(shell, heading.nextSibling);
        } else {
            container.insertBefore(shell, container.firstChild);
        }

        var firstCard = allCards[0];
        firstCard.parentNode.insertBefore(panelsWrap, firstCard);

        allCards.forEach(function(card){
            var key = bdpPanelKey(card);
            if (!panels[key]) key = 'sync';
            panels[key].appendChild(card);
        });

        tabsConfig.forEach(function(item){
            var panel = panels[item.key];
            var tab = tabs.querySelector('[data-tab="' + item.key + '"]');
            if (!panel.children.length && tab) {
                tab.style.display = 'none';
                panel.style.display = 'none';
            }
        });

        function activate(key) {
            Array.from(tabs.querySelectorAll('.bdp-settings-tab')).forEach(function(btn){
                btn.classList.toggle('is-active', btn.dataset.tab === key);
            });
            Array.from(panelsWrap.querySelectorAll('.bdp-settings-tab-panel')).forEach(function(panel){
                panel.classList.toggle('is-active', panel.dataset.panel === key);
            });
            var cfg = tabsConfig.find(function(i){ return i.key === key; });
            help.textContent = cfg ? cfg.help : '';
            try { localStorage.setItem('bdpSettingsActiveTab', key); } catch(e) {}
        }

        tabs.addEventListener('click', function(e){
            var btn = e.target.closest('.bdp-settings-tab');
            if (!btn) return;
            activate(btn.dataset.tab);
        });

        var saved = null;
        try { saved = localStorage.getItem('bdpSettingsActiveTab'); } catch(e) {}
        var firstVisible = Array.from(tabs.querySelectorAll('.bdp-settings-tab')).find(function(btn){
            return btn.style.display !== 'none';
        });
        var savedBtn = saved ? tabs.querySelector('[data-tab="' + saved + '"]') : null;
        var target = (savedBtn && savedBtn.style.display !== 'none') ? saved : (firstVisible ? firstVisible.dataset.tab : 'store');
        activate(target);
    }

    if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', bdpInitSettingsTabs);
    } else {
        bdpInitSettingsTabs();
    }
})();
</script>
