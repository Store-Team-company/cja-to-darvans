<script>
document.addEventListener('DOMContentLoaded', function () {
    const panels = document.querySelectorAll('.bdp-tool-panel');
    const toggles = document.querySelectorAll('[data-product-tool]');
    const storageKey = 'bdp-products-open-tool';

    function openPanel(id) {
        panels.forEach(panel => panel.classList.toggle('is-open', panel.id === id));
        toggles.forEach(btn => btn.classList.toggle('active', btn.dataset.productTool === id));
        if (id) {
            localStorage.setItem(storageKey, id);
        } else {
            localStorage.removeItem(storageKey);
        }
    }

    toggles.forEach(btn => btn.addEventListener('click', () => {
        const panel = document.getElementById(btn.dataset.productTool);
        openPanel(panel && panel.classList.contains('is-open') ? null : btn.dataset.productTool);
    }));

    document.querySelectorAll('[data-close-tool]').forEach(btn => btn.addEventListener('click', () => openPanel(null)));

    const saved = localStorage.getItem(storageKey);
    if (saved && document.getElementById(saved)) {
        openPanel(saved);
    }

    const selects = Array.from(document.querySelectorAll('.bdp-product-select'));
    const checkAll = document.getElementById('bdp-check-all');
    const selectedBar = document.getElementById('bdp-selected-bar');
    const selectedCount = document.getElementById('bdp-selected-count');

    function updateSelected() {
        const count = selects.filter(cb => cb.checked).length;
        selectedCount.textContent = count;
        selectedBar.style.display = count > 0 ? 'flex' : 'none';
        if (checkAll) {
            checkAll.checked = count > 0 && count === selects.length;
        }
    }

    selects.forEach(cb => cb.addEventListener('change', updateSelected));

    if (checkAll) {
        checkAll.addEventListener('change', () => {
            selects.forEach(cb => cb.checked = checkAll.checked);
            updateSelected();
        });
    }

    const selectVisible = document.getElementById('bdp-select-visible');
    const unselectVisible = document.getElementById('bdp-unselect-visible');
    const clearSelection = document.getElementById('bdp-clear-selection');

    if (selectVisible) {
        selectVisible.addEventListener('click', () => {
            selects.forEach(cb => cb.checked = true);
            updateSelected();
        });
    }

    if (unselectVisible) {
        unselectVisible.addEventListener('click', () => {
            selects.forEach(cb => cb.checked = false);
            updateSelected();
        });
    }

    if (clearSelection) {
        clearSelection.addEventListener('click', () => {
            selects.forEach(cb => cb.checked = false);
            updateSelected();
        });
    }

    updateSelected();
});
</script>

<script>
document.addEventListener('DOMContentLoaded', function () {
    // BDP collapsible Find & Filter Products patch
    const filterCard = document.getElementById('product-controls') || document.querySelector('.bdp-products-search-card');
    if (!filterCard || filterCard.dataset.bdpFilterToggleReady === '1') return;
    filterCard.dataset.bdpFilterToggleReady = '1';

    const header = filterCard.querySelector('.bdp-card-header') || filterCard.firstElementChild;
    const storageKey = 'bdp-products-filter-open';
    const toggleBtn = document.createElement('button');
    toggleBtn.type = 'button';
    toggleBtn.className = 'bdp-filter-toggle-btn';

    if (header) {
        header.style.display = 'flex';
        header.style.alignItems = 'flex-start';
        header.style.justifyContent = 'space-between';
        header.style.gap = '14px';
        header.appendChild(toggleBtn);
    } else {
        filterCard.prepend(toggleBtn);
    }

    function hasActiveFilters() {
        const params = new URLSearchParams(window.location.search);
        const q = (params.get('q') || '').trim();
        const category = (params.get('category') || '').trim();
        const label = (params.get('label') || 'all').trim();
        const status = (params.get('status') || 'all').trim();
        const perPage = (params.get('per_page') || '').trim();
        return !!q || !!category || (label && label !== 'all') || (status && status !== 'all') || (perPage && perPage !== '25');
    }

    function setOpen(open) {
        filterCard.classList.toggle('is-collapsed', !open);
        toggleBtn.textContent = open ? 'Hide Find & Filter Products' : 'Find & Filter Products';
        toggleBtn.setAttribute('aria-expanded', open ? 'true' : 'false');
        localStorage.setItem(storageKey, open ? '1' : '0');
    }

    const saved = localStorage.getItem(storageKey);
    const defaultOpen = saved === '1' || (saved === null && hasActiveFilters());
    setOpen(defaultOpen);

    toggleBtn.addEventListener('click', function () {
        setOpen(filterCard.classList.contains('is-collapsed'));
    });
});
</script>

