@php
    $tabs = [
        'all' => 'All',
        'not_synced' => 'Not Synced',
        'synced' => 'Synced',
        'needs_review' => 'Needs Review',
        'failed' => 'Failed',
    ];

    $bdpSettingsRows = [];

    try {
        if (\Illuminate\Support\Facades\Schema::hasTable('bdp_settings')) {
            $bdpSettingsRows = \Illuminate\Support\Facades\DB::table('bdp_settings')->pluck('value', 'key')->toArray();
        }
    } catch (\Throwable $e) {
        $bdpSettingsRows = [];
    }

    $bdpSetting = function (array $keys, $default = null) use ($bdpSettingsRows) {
        foreach ($keys as $key) {
            if (array_key_exists($key, $bdpSettingsRows) && $bdpSettingsRows[$key] !== null && $bdpSettingsRows[$key] !== '') {
                return $bdpSettingsRows[$key];
            }
        }

        return $default;
    };

    $bdpBool = function ($value, $default = false) {
        if ($value === null || $value === '') {
            return (bool) $default;
        }

        return filter_var($value, FILTER_VALIDATE_BOOLEAN, FILTER_NULL_ON_FAILURE) ?? (bool) $default;
    };

    $bdpSyncDefault = $bdpSetting(['default_sync_status', 'sync_status'], 'draft');

    $bdpCopyVariation = $bdpBool(
        $bdpSetting(['copy_variation_images_to_shofy', 'copy_variation_images'], null),
        true
    );

    $bdpParentFeatured = $bdpBool(
        $bdpSetting(['push_parent_featured_image', 'sync_parent_featured_image', 'parent_image_sync'], null),
        false
    );

    $bdpParentGallery = $bdpBool(
        $bdpSetting(['push_parent_gallery_images', 'sync_parent_gallery_images', 'gallery_image_sync'], null),
        false
    );

    $bdpParentSync = $bdpParentFeatured || $bdpParentGallery;
