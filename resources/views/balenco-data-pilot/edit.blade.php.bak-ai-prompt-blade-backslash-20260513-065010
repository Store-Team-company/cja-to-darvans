<script>
(function () {
    function textOf(el) {
        return (el && el.textContent ? el.textContent : '').replace(/\s+/g, ' ').trim().toLowerCase();
    }

    function findVariationsCard() {
        // Prefer a card that has the Variations title.
        var titles = Array.from(document.querySelectorAll('h2,h3,h4,.bdp-card-title'));
        for (var i = 0; i < titles.length; i++) {
            if (textOf(titles[i]).indexOf('variations') === 0) {
                var card = titles[i].closest('.bdp-card') || titles[i].closest('section') || titles[i].parentElement;
                if (card) return card;
            }
        }

        // Fallback: find any variation input/table and use its card.
        var variationInput = document.querySelector('input[name*="variations"], select[name*="variations"], textarea[name*="variations"]');
        if (variationInput) return variationInput.closest('.bdp-card') || variationInput.closest('section');

        return null;
    }

    function getHeader(card) {
        return card.querySelector('.bdp-card-header') || card.firstElementChild;
    }

    function getBodies(card, header) {
        var children = Array.from(card.children);
        var bodies = children.filter(function (child) {
            return child !== header && !child.classList.contains('bdp-force-vars-toggle-holder');
        });

        // If previous patches wrapped content in a hidden body, include it too.
        Array.from(card.querySelectorAll('.bdp-variations-body,.bdp-vars-body,.bdp-variation-body,[data-variation-body]')).forEach(function (el) {
            if (bodies.indexOf(el) === -1 && el !== header) bodies.push(el);
        });

        return bodies;
    }

    function removeOldButtons(card) {
        Array.from(card.querySelectorAll('button,a')).forEach(function (btn) {
            var t = textOf(btn);
            if (t === 'show variations' || t === 'hide variations') {
                btn.remove();
            }
        });
    }

    function init() {
        var card = findVariationsCard();
        if (!card || card.dataset.bdpFinalVariationToggle === '1') return;
        card.dataset.bdpFinalVariationToggle = '1';
        card.id = card.id || 'variations';

        var header = getHeader(card);
        if (!header) return;

        removeOldButtons(card);

        // Make header able to hold the toggle button nicely.
        header.style.display = header.style.display || 'flex';
        header.style.alignItems = header.style.alignItems || 'center';
        header.style.justifyContent = header.style.justifyContent || 'space-between';
        header.style.gap = header.style.gap || '12px';

        var btn = document.createElement('button');
        btn.type = 'button';
        btn.className = 'bdp-force-vars-toggle';
        btn.dataset.bdpVariationsToggle = '1';
        header.appendChild(btn);

        var open = false;

        function setOpen(nextOpen) {
            open = !!nextOpen;
            var bodies = getBodies(card, header);

            bodies.forEach(function (body) {
                body.classList.toggle('bdp-force-vars-hidden', !open);
                body.hidden = false;
                body.removeAttribute('hidden');
                body.classList.remove('hidden', 'is-hidden', 'bdp-hidden', 'bdp-variations-hidden');
                if (open) {
                    body.style.removeProperty('display');
                    body.style.removeProperty('visibility');
                    body.style.removeProperty('height');
                    body.style.removeProperty('max-height');
                    body.style.removeProperty('overflow');
                }
            });

            // Remove inline hiding from descendants when opening.
            if (open) {
                Array.from(card.querySelectorAll('[style]')).forEach(function (el) {
                    var style = (el.getAttribute('style') || '').toLowerCase();
                    if (style.indexOf('display: none') !== -1 || style.indexOf('display:none') !== -1) {
                        el.style.removeProperty('display');
                    }
                    el.hidden = false;
                    el.removeAttribute('hidden');
                });
            }

            btn.textContent = open ? 'Hide variations' : 'Show variations';
            card.classList.toggle('bdp-variations-open', open);
            card.classList.toggle('bdp-variations-closed', !open);
        }

        btn.addEventListener('click', function (e) {
            e.preventDefault();
            e.stopPropagation();
            setOpen(!open);
        });

        // Top Variations tab should open section and scroll to it.
        Array.from(document.querySelectorAll('a,button')).forEach(function (tab) {
            if (textOf(tab) === 'variations' && tab !== btn) {
                tab.addEventListener('click', function () {
                    setOpen(true);
                    setTimeout(function () { card.scrollIntoView({ behavior: 'smooth', block: 'start' }); }, 80);
                });
            }
        });

        // Default collapsed.
        setOpen(false);
    }

    if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', init);
    } else {
        init();
    }

    // Run again after other scripts finish, because older patches may modify the card later.
    window.addEventListener('load', function () {
        setTimeout(init, 300);
        setTimeout(init, 900);
    });
})();
</script>
