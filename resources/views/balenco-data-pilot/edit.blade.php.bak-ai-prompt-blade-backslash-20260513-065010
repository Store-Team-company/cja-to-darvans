<script>
(function () {
    'use strict';

    function bdpText(el) {
        return (el && (el.innerText || el.textContent || '') || '').trim();
    }

    function bdpFindButtonByText(text) {
        text = String(text || '').toLowerCase();
        return Array.from(document.querySelectorAll('button, a, input[type="button"], input[type="submit"]')).find(function (el) {
            var label = (el.value || bdpText(el)).toLowerCase();
            return label.indexOf(text) !== -1;
        });
    }

    function bdpFindAiJsonBox() {
        var selectors = [
            '#bdp-ai-json-output',
            '#bdp-ai-output-json',
            '#bdp-ai-result',
            'textarea[name="ai_json"]',
            'textarea[name="ai_output"]',
            'textarea[id*="json" i]',
            'textarea[name*="json" i]'
        ];

        for (var i = 0; i < selectors.length; i++) {
            var found = document.querySelector(selectors[i]);
            if (found) return found;
        }

        return Array.from(document.querySelectorAll('textarea')).find(function (textarea) {
            var ph = (textarea.getAttribute('placeholder') || '').toLowerCase();
            var label = '';
            var parent = textarea.closest('div, section, aside, .bdp-card');
            if (parent) label = bdpText(parent).toLowerCase();
            return ph.indexOf('json') !== -1 || label.indexOf('paste ai json') !== -1 || label.indexOf('json output') !== -1;
        }) || null;
    }

    function bdpGetAiLongDescription() {
        var box = bdpFindAiJsonBox();
        if (!box || !box.value.trim()) return '';

        try {
            var data = JSON.parse(box.value.trim());
            return data.long_description || data.content || data.description_long || data.full_description || data.product_content || '';
        } catch (e) {
            console.warn('BDP: Cannot parse AI JSON for long description.', e);
            return '';
        }
    }

    function bdpSetTextareaValue(field, value) {
        if (!field) return false;
        field.value = value;
        field.dispatchEvent(new Event('input', { bubbles: true }));
        field.dispatchEvent(new Event('change', { bubbles: true }));
        return true;
    }

    function bdpSetTinyMce(field, value) {
        if (!window.tinymce || !field) return false;
        var updated = false;

        if (field.id && window.tinymce.get(field.id)) {
            window.tinymce.get(field.id).setContent(value || '');
            window.tinymce.get(field.id).save();
            updated = true;
        }

        try {
            (window.tinymce.editors || []).forEach(function (editor) {
                if (editor && editor.targetElm === field) {
                    editor.setContent(value || '');
                    editor.save();
                    updated = true;
                }
            });
        } catch (e) {}

        return updated;
    }

    function bdpSetCkEditor(field, value) {
        if (!window.CKEDITOR || !field) return false;
        var updated = false;

        Object.keys(window.CKEDITOR.instances || {}).forEach(function (key) {
            var instance = window.CKEDITOR.instances[key];
            if (instance && instance.element && instance.element.$ === field) {
                instance.setData(value || '');
                instance.updateElement();
                updated = true;
            }
        });

        return updated;
    }

    function bdpSetQuillLikeLongEditor(value) {
        var updated = false;

        // In this Data Pilot screen there are usually two rich editors:
        // editor #1 = short description, editor #2 = long description/content.
        var editors = Array.from(document.querySelectorAll('.ql-editor, [contenteditable="true"]')).filter(function (el) {
            return !!(el.offsetWidth || el.offsetHeight || el.getClientRects().length);
        });

        var longEditor = null;

        // Prefer an editor inside/near a section that mentions long description or product content.
        editors.forEach(function (editor) {
            if (longEditor) return;
            var card = editor.closest('.bdp-card, .bdp-editor-card, .form-group, .mb-3, div');
            var text = card ? bdpText(card).toLowerCase() : '';
            if (text.indexOf('long description') !== -1 || text.indexOf('product content') !== -1 || text.indexOf('content') !== -1) {
                longEditor = editor;
            }
        });

        // Fallback: second editor is usually long description.
        if (!longEditor && editors.length > 1) {
            longEditor = editors[1];
        }

        if (longEditor) {
            longEditor.innerHTML = value || '';
            longEditor.dispatchEvent(new Event('input', { bubbles: true }));
            longEditor.dispatchEvent(new Event('change', { bubbles: true }));
            updated = true;
        }

        return updated;
    }

    function bdpApplyLongDescriptionFromAi() {
        var value = bdpGetAiLongDescription();
        if (!value) return;

        var field = document.querySelector('textarea[name="content"], textarea[name="long_description"], textarea[name="product_content"], [name="content"]');

        if (field) {
            bdpSetTextareaValue(field, value);
            bdpSetTinyMce(field, value);
            bdpSetCkEditor(field, value);
        }

        bdpSetQuillLikeLongEditor(value);
    }

    function bdpSyncLongEditorToTextareaBeforeSubmit() {
        var field = document.querySelector('textarea[name="content"], textarea[name="long_description"], textarea[name="product_content"], [name="content"]');
        if (!field) return;

        // If a visible Quill/editor exists for long description, copy its HTML back into the real textarea before save.
        var editors = Array.from(document.querySelectorAll('.ql-editor, [contenteditable="true"]')).filter(function (el) {
            return !!(el.offsetWidth || el.offsetHeight || el.getClientRects().length);
        });
        var longEditor = editors.length > 1 ? editors[1] : null;

        if (longEditor && longEditor.innerHTML.trim()) {
            bdpSetTextareaValue(field, longEditor.innerHTML.trim());
        }

        bdpSetTinyMce(field, field.value);
        bdpSetCkEditor(field, field.value);
    }

    document.addEventListener('click', function (event) {
        var btn = event.target.closest('button, a, input[type="button"], input[type="submit"]');
        if (!btn) return;

        var label = (btn.value || bdpText(btn)).toLowerCase();

        if (label.indexOf('apply ai output') !== -1 || label.indexOf('apply output') !== -1) {
            setTimeout(bdpApplyLongDescriptionFromAi, 80);
            setTimeout(bdpApplyLongDescriptionFromAi, 350);
        }

        if (label.indexOf('save product') !== -1 || label.indexOf('sync as draft') !== -1 || label.indexOf('sync to') !== -1) {
            bdpSyncLongEditorToTextareaBeforeSubmit();
        }
    }, true);

    document.addEventListener('submit', function () {
        bdpSyncLongEditorToTextareaBeforeSubmit();
    }, true);

    window.bdpApplyLongDescriptionFromAi = bdpApplyLongDescriptionFromAi;
})();
</script>
