<script>
(function(){
    'use strict';

    function text(el){ return (el && (el.innerText || el.textContent) || '').trim(); }
    function byText(selector, needle){
        needle = String(needle).toLowerCase();
        return Array.from(document.querySelectorAll(selector)).find(function(el){ return text(el).toLowerCase().includes(needle); });
    }
    function closestCard(el){
        return el ? (el.closest('.bdp-card, aside, .bdp-edit-side, .bdp-ai-tools-card, .card, .widget, .box') || el.parentElement) : null;
    }
    function getValue(names){
        for (var i=0;i<names.length;i++) {
            var el = document.querySelector('[name="'+names[i]+'"], #'+names[i]);
            if (el && typeof el.value !== 'undefined' && String(el.value).trim()) return String(el.value).trim();
        }
        return '';
    }
    function getEditorValue(names){
        for (var i=0;i<names.length;i++) {
            var el = document.querySelector('[name="'+names[i]+'"], #'+names[i]);
            if (!el) continue;
            if (window.tinymce && el.id && tinymce.get(el.id)) {
                var v = tinymce.get(el.id).getContent({format:'text'}).trim();
                if (v) return v;
            }
            if (typeof el.value !== 'undefined' && String(el.value).trim()) return String(el.value).trim();
            if (el.innerText && el.innerText.trim()) return el.innerText.trim();
        }
        return '';
    }
    function getSetting(id, fallback){
        var el = document.getElementById(id);
        return el && el.value ? el.value : fallback;
    }
    function getBuyerIntent(card){
        var select = card ? Array.from(card.querySelectorAll('select')).find(function(s){
            var label = text(s.closest('label') || s.parentElement).toLowerCase();
            return label.includes('buyer') || Array.from(s.options || []).some(function(o){ return /everyday|party|office|casual|travel|summer|dressy/i.test(o.value || o.text); });
        }) : null;
        return select && select.value ? select.value : getSetting('bdp-ai-default-buyer-intent', 'Everyday wear');
    }
    function buildPrompt(card){
        var title = getValue(['title','name','product_title']) || 'Product title not provided';
        var sku = getValue(['sku']);
        var slug = getValue(['slug','url_slug']);
        var categories = getValue(['categories','category']);
        var tags = getValue(['tags','tag']);
        var shortDesc = getEditorValue(['short_description','description']);
        var longDesc = getEditorValue(['content','long_description']);
        var buyerIntent = getBuyerIntent(card);
        var shortWords = getSetting('bdp-ai-short-words', '40-60');
        var longWords = getSetting('bdp-ai-long-words', '180-230');
        var metaChars = getSetting('bdp-ai-meta-chars', '150-160');
        var tagsCount = getSetting('bdp-ai-tags-count', '6');

        return [
            'Act as a senior ecommerce SEO strategist, product content writer, and conversion optimization expert.',
            '',
            'Rewrite and optimize this product listing for Google SEO, buyer intent, and conversion.',
            '',
            'Important rules:',
            '- Use only the product facts provided.',
            '- Do not invent materials, comfort claims, medical claims, waterproof claims, warranty claims, shipping promises, or brand claims.',
            '- Do not mention supplier names, CJ, CJDropshipping, AliExpress, Alibaba, warehouse, factory, source product ID, or supplier SKU prefixes.',
            '- Do not expose supplier SKU prefixes in public slugs.',
            '- Use American English.',
            '- Target market: USA.',
            '- Buyer intent: '+ buyerIntent +'.',
            '- Write for real ecommerce buyers first, SEO second.',
            '- Avoid keyword stuffing.',
            '',
            'Slug rule:',
            '- If SKU contains CJ/CJNS prefix, remove the public prefix and use b + number at the end of slug.',
            '- Example CJNS1274506 becomes b1274506.',
            '',
            'Length rules:',
            '- Short description: '+ shortWords +' words.',
            '- Long description: '+ longWords +' words.',
            '- Meta description: '+ metaChars +' characters.',
            '- Tags count: '+ tagsCount +'.',
            '',
            'Product data:',
            'Title: '+ title,
            'SKU: '+ sku,
            'Current slug: '+ slug,
            'Categories: '+ categories,
            'Tags: '+ tags,
            'Short description: '+ shortDesc,
            'Long description/content: '+ longDesc,
            '',
            'Return only valid JSON with this exact structure:',
            '{',
            '  "title": "",',
            '  "slug": "",',
            '  "short_description": "",',
            '  "long_description": "",',
            '  "focus_keyword": "",',
            '  "seo_title": "",',
            '  "seo_description": "",',
            '  "tags": []',
            '}'
        ].join('\n');
    }
    function findAiCard(){
        var heading = Array.from(document.querySelectorAll('h1,h2,h3,h4,strong,.bdp-card-title')).find(function(el){ return text(el).toLowerCase().includes('ai seo tools'); });
        return closestCard(heading) || document.querySelector('.bdp-edit-side, aside') || document;
    }
    function ensurePromptBox(card){
        var box = document.getElementById('bdp-ai-generated-prompt');
        if (box) return box;
        var copyBtn = byText('button,a', 'Copy Prompt') || byText('button,a', 'Copied');
        var wrap = document.createElement('div');
        wrap.className = 'bdp-ai-generated-prompt-wrap';
        wrap.innerHTML = '<label style="display:block;margin:10px 0 6px;font-weight:800;color:#334155">Generated prompt</label><textarea id="bdp-ai-generated-prompt" readonly></textarea>';
        if (copyBtn && copyBtn.parentNode) copyBtn.parentNode.insertBefore(wrap, copyBtn.nextSibling);
        else (card || document.body).appendChild(wrap);
        return wrap.querySelector('textarea');
    }
    function hidePromptSettings(card){
        if (!card) return;
        Array.from(card.querySelectorAll('label,small,span,div')).forEach(function(el){
            var t = text(el).toLowerCase();
            if (['short description words','long description words','meta description chars','tags count','prompt settings'].some(function(k){ return t === k || t.includes(k); })) {
                var row = el.closest('.bdp-form-grid, .bdp-grid, .form-grid, .row, .bdp-ai-settings, .bdp-setting-row, div');
                if (row && !t.includes('buyer intent')) row.classList.add('bdp-ai-hidden-setting');
            }
        });
    }
    function init(){
        var card = findAiCard();
        hidePromptSettings(card);
        var promptBox = ensurePromptBox(card);
        var promptWrap = promptBox.closest('.bdp-ai-generated-prompt-wrap') || promptBox.parentElement;
        if (promptWrap) promptWrap.style.display = 'none';

        var buildBtn = byText('button,a', 'Build AI Prompt') || document.getElementById('bdp-build-ai-prompt');
        var copyBtn = byText('button,a', 'Copy Prompt') || byText('button,a', 'Copied') || document.getElementById('bdp-copy-ai-prompt');
        [buildBtn, copyBtn].forEach(function(btn){ if(btn) btn.classList.add('bdp-ai-safe-btn'); });

        if (buildBtn) {
            buildBtn.addEventListener('click', function(e){
                e.preventDefault();
                e.stopImmediatePropagation();
                promptBox.value = buildPrompt(card);
                if (promptWrap) promptWrap.style.display = 'block';
                if (copyBtn) copyBtn.textContent = 'Copy Prompt';
                return false;
            }, true);
        }
        if (copyBtn) {
            copyBtn.addEventListener('click', function(e){
                e.preventDefault();
                e.stopImmediatePropagation();
                if (!promptBox.value.trim()) promptBox.value = buildPrompt(card);
                function done(){
                    if (promptWrap) promptWrap.style.display = 'none';
                    copyBtn.textContent = 'Copied';
                    setTimeout(function(){ copyBtn.textContent = 'Copy Prompt'; }, 1300);
                }
                if (navigator.clipboard && window.isSecureContext) {
                    navigator.clipboard.writeText(promptBox.value).then(done).catch(function(){ promptBox.select(); document.execCommand('copy'); done(); });
                } else {
                    promptBox.style.display = 'block';
                    promptBox.select();
                    document.execCommand('copy');
                    done();
                }
                return false;
            }, true);
        }
    }
    if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', init);
    else init();
})();
</script>
