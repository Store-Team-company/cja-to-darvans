<script>
(function(){
    function ready(fn){
        if(document.readyState !== 'loading') fn();
        else document.addEventListener('DOMContentLoaded', fn);
    }

    ready(function(){
        try{
            var main = document.querySelector('.bdp-content, .bdp-main, main, .bdp-app');
            if(!main) return;

            // Remove duplicate old tab bars if any.
            document.querySelectorAll('.bdp-settings-tabs-shell, .bdp-settings-tabs-help').forEach(function(el){ el.remove(); });

            var tabMap = [
                {key:'connected', label:'Connected Store', tests:['connected store','push connection method']},
                {key:'sync', label:'Sync Settings', tests:['sync settings']},
                {key:'ai', label:'AI SEO Prompt', tests:['ai seo prompt settings','ai prompt settings']},
                {key:'pricing', label:'Pricing Defaults', tests:['pricing defaults']},
                {key:'categories', label:'Categories', tests:['optional category sync','balenco category source','category source','categories']}
            ];

            function norm(s){ return (s || '').replace(/\s+/g,' ').trim().toLowerCase(); }
            function cardFor(el){ return el.closest('.bdp-card, .card, .bdp-settings-card'); }
            function findHeadingCards(){
                var cardsByKey = {};
                tabMap.forEach(function(t){ cardsByKey[t.key] = []; });
                var heads = Array.prototype.slice.call(main.querySelectorAll('h1,h2,h3,h4,.bdp-card-title,.card-title,label,strong'));
                heads.forEach(function(h){
                    var txt = norm(h.textContent);
                    if(!txt) return;
                    tabMap.forEach(function(t){
                        if(t.tests.some(function(test){ return txt.indexOf(test) !== -1; })){
                            var c = cardFor(h);
                            if(c && cardsByKey[t.key].indexOf(c) === -1){
                                cardsByKey[t.key].push(c);
                                c.classList.add('bdp-settings-clean-card');
                            }
                        }
                    });
                });
                return cardsByKey;
            }

            var groups = findHeadingCards();
            var total = Object.keys(groups).reduce(function(n,k){ return n + groups[k].length; }, 0);
            if(total < 2) return; // Do not hide anything if matching failed.

            // Insert tabs after Settings heading, fallback after top of main.
            var settingsTitle = Array.prototype.slice.call(main.querySelectorAll('h1,h2')).find(function(h){ return norm(h.textContent) === 'settings'; });
            var shell = document.createElement('div');
            shell.className = 'bdp-settings-tabs-shell';
            shell.innerHTML = '<div class="bdp-settings-tabs-nav"></div>';
            var nav = shell.querySelector('.bdp-settings-tabs-nav');
            tabMap.forEach(function(t){
                if(groups[t.key] && groups[t.key].length){
                    var b = document.createElement('button');
                    b.type = 'button';
                    b.className = 'bdp-settings-tab-btn';
                    b.dataset.tab = t.key;
                    b.textContent = t.label;
                    nav.appendChild(b);
                }
            });
            var help = document.createElement('p');
            help.className = 'bdp-settings-tabs-help';
            help.textContent = 'Settings are grouped by workflow. Choose one tab to manage that area.';
            if(settingsTitle && settingsTitle.parentNode){
                settingsTitle.insertAdjacentElement('afterend', shell);
                shell.insertAdjacentElement('afterend', help);
            } else {
                main.insertBefore(help, main.firstChild);
                main.insertBefore(shell, help);
            }

            function activate(key){
                var anyVisible = false;
                tabMap.forEach(function(t){
                    (groups[t.key] || []).forEach(function(card){
                        if(t.key === key){
                            card.classList.remove('bdp-settings-panel-hidden');
                            card.classList.add('bdp-settings-panel-visible');
                            anyVisible = true;
                        } else {
                            card.classList.add('bdp-settings-panel-hidden');
                            card.classList.remove('bdp-settings-panel-visible');
                        }
                    });
                });
                if(!anyVisible){
                    Object.keys(groups).forEach(function(k){ (groups[k] || []).forEach(function(card){ card.classList.remove('bdp-settings-panel-hidden'); }); });
                    return;
                }
                nav.querySelectorAll('.bdp-settings-tab-btn').forEach(function(btn){ btn.classList.toggle('is-active', btn.dataset.tab === key); });
                try{ localStorage.setItem('bdp_settings_active_tab', key); }catch(e){}
            }

            nav.addEventListener('click', function(e){
                var btn = e.target.closest('.bdp-settings-tab-btn');
                if(btn) activate(btn.dataset.tab);
            });

            var defaultTab = 'connected';
            try{
                var saved = localStorage.getItem('bdp_settings_active_tab');
                if(saved && groups[saved] && groups[saved].length) defaultTab = saved;
            }catch(e){}
            activate(defaultTab);

            // Hide misleading old domain warning when DB connection details exist.
            var dbHost = document.querySelector('[name="store_db_host"], [name="database_host"], input[id*="db_host"]');
            if(dbHost && dbHost.value.trim()){
                Array.prototype.slice.call(document.querySelectorAll('.bdp-alert, .alert, .bdp-input-help, div, p')).forEach(function(el){
                    var t = norm(el.textContent);
                    if(t.indexOf('no connected store domain saved yet') !== -1){ el.style.display = 'none'; }
                });
            }

            // Add one learn-more modal, used by small links.
            var modal = document.createElement('div');
            modal.className = 'bdp-settings-learn-modal-backdrop';
            modal.innerHTML = '<div class="bdp-settings-learn-modal"><h3>Connected Store Help</h3><p><strong>Store name</strong> is only an internal label. <strong>Store domain</strong> is the public website URL used for previews and store identity.</p><ul><li><strong>Direct database</strong> pushes products using DB host, DB name, username, and password. No target-store secret key is needed.</li><li><strong>API receiver</strong> pushes products to a secure endpoint and requires an API URL plus secret key.</li><li><strong>Database host</strong> should be the MySQL server IP/host, not necessarily the website domain.</li></ul><button type="button" class="bdp-settings-learn-close">Close</button></div>';
            document.body.appendChild(modal);
            modal.addEventListener('click', function(e){ if(e.target === modal || e.target.classList.contains('bdp-settings-learn-close')) modal.style.display = 'none'; });
            Array.prototype.slice.call(document.querySelectorAll('h3,h4,strong,label')).forEach(function(el){
                if(norm(el.textContent).indexOf('connected store') !== -1 && !el.querySelector('.bdp-settings-small-link')){
                    var a = document.createElement('a');
                    a.href = '#';
                    a.className = 'bdp-settings-small-link';
                    a.textContent = 'Learn more';
                    a.addEventListener('click', function(ev){ ev.preventDefault(); modal.style.display = 'flex'; });
                    el.appendChild(a);
                }
            });
        } catch(err){
            console.error('Data Pilot settings tabs failed safely:', err);
            document.querySelectorAll('.bdp-settings-panel-hidden').forEach(function(el){ el.classList.remove('bdp-settings-panel-hidden'); });
        }
    });
})();
</script>
