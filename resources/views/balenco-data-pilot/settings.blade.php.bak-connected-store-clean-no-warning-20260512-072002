<script>
(function () {
    const saved = @json($bdpConnectedStoreSaved ?? []);

    function setField(name, value) {
        if (value === undefined || value === null || value === '') return;
        const fields = document.querySelectorAll('[name="' + name + '"]');
        fields.forEach(function (field) {
            if (!field) return;
            if (field.tagName === 'SELECT') {
                Array.from(field.options).forEach(function (option) {
                    if (String(option.value).toLowerCase() === String(value).toLowerCase() || String(option.text).toLowerCase().includes(String(value).toLowerCase())) {
                        field.value = option.value;
                    }
                });
            } else {
                field.value = value;
            }
            field.dispatchEvent(new Event('change', { bubbles: true }));
        });
    }

    function applySavedConnectedStoreValues() {
        const aliases = {
            store_push_method: ['store_push_method', 'push_method'],
            store_db_host: ['store_db_host', 'connected_store_db_host', 'db_host'],
            store_db_port: ['store_db_port', 'connected_store_db_port', 'db_port'],
            store_db_database: ['store_db_database', 'store_db_name', 'connected_store_db_database', 'db_database'],
            store_db_username: ['store_db_username', 'connected_store_db_username', 'db_username'],
            store_db_password: ['store_db_password', 'connected_store_db_password', 'db_password'],
            store_db_prefix: ['store_db_prefix', 'connected_store_db_prefix', 'db_prefix'],
            store_name: ['store_name', 'connected_store_name'],
            store_domain: ['store_domain', 'connected_store_domain'],
            store_api_url: ['store_api_url', 'store_admin_api_url', 'connected_store_api_url', 'api_url'],
            store_api_secret: ['store_api_secret', 'connected_store_api_secret', 'api_secret'],
            store_status: ['store_status', 'connected_store_status']
        };

        Object.keys(aliases).forEach(function (key) {
            aliases[key].forEach(function (name) {
                setField(name, saved[key]);
            });
        });

        // Hide misleading warning if either store domain or direct DB details are saved.
        const hasConnection = !!(saved.store_domain || saved.store_db_host || saved.store_db_database);
        if (hasConnection) {
            document.querySelectorAll('.bdp-alert, .bdp-notice, .alert, [class*="warning"], [class*="orange"]').forEach(function (el) {
                const text = (el.textContent || '').toLowerCase();
                if (text.includes('no connected store domain') || text.includes('add a store domain before')) {
                    el.style.display = 'none';
                }
            });
        }
    }

    if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', applySavedConnectedStoreValues);
    } else {
        applySavedConnectedStoreValues();
    }
})();
</script>
