<script id="bdp-import-page-production-js">
(function () {
    // Improve any existing SEO CSV form without depending on exact Blade structure.
    function enhanceSeoImportForm() {
        var forms = Array.prototype.slice.call(document.querySelectorAll('form'));
        forms.forEach(function (form) {
            var action = form.getAttribute('action') || '';
            if (action.indexOf('bulk-optimization/import') === -1) return;
            if (form.dataset.bdpEnhanced === '1') return;

            form.dataset.bdpEnhanced = '1';

            var panel = document.createElement('div');
            panel.className = 'bdp-seo-import-panel';

            var header = document.createElement('div');
            header.className = 'bdp-seo-import-panel__header';
            header.innerHTML =
                '<div>' +
                '<h2>Update Products from Optimized SEO CSV</h2>' +
                '<p>Use this only for the slim Data Pilot SEO/content CSV. It updates product title, SKU, slug, descriptions, tags, meta title, meta description, and focus keyword.</p>' +
                '</div>' +
                '<a class="bdp-btn light" href="' + (window.location.origin + window.location.pathname.replace(/\/import.*/, '/products')) + '">Back to Products</a>';

            var notice = document.createElement('div');
            notice.className = 'bdp-seo-import-notice';
            notice.innerHTML =
                '<strong>Safe matching:</strong> The importer matches by <strong>product_id first</strong>. ' +
                'SKU can be updated from the CSV. If product_id is empty, SKU is used only as fallback matching. ' +
                'Do not change <strong>row_type</strong> or <strong>product_id</strong>.';

            form.parentNode.insertBefore(panel, form);
            panel.appendChild(header);
            panel.appendChild(notice);
            panel.appendChild(form);

            form.classList.add('bdp-seo-import-grid');

            var fileInput = form.querySelector('input[type="file"]');
            if (fileInput && !fileInput.closest('.bdp-seo-import-field')) {
                var wrap = document.createElement('div');
                wrap.className = 'bdp-seo-import-field';
                fileInput.parentNode.insertBefore(wrap, fileInput);
                wrap.innerHTML = '<label>Optimized SEO CSV File</label>';
                wrap.appendChild(fileInput);
            }

            var checkbox = form.querySelector('input[name="update_products"]');
            if (checkbox && !checkbox.closest('.bdp-seo-import-confirm')) {
                var confirm = document.createElement('div');
                confirm.className = 'bdp-seo-import-confirm';
                checkbox.parentNode.insertBefore(confirm, checkbox);
                confirm.appendChild(checkbox);

                var label = document.createElement('label');
                label.textContent = 'Yes, update existing Data Pilot products using this optimized SEO/content CSV.';
                confirm.appendChild(label);
            }

            var submit = form.querySelector('button[type="submit"], input[type="submit"]');
            if (submit && !submit.closest('.bdp-seo-import-actions')) {
                var actions = document.createElement('div');
                actions.className = 'bdp-seo-import-actions';
                submit.parentNode.insertBefore(actions, submit);
                actions.appendChild(submit);

                var help = document.createElement('div');
                help.className = 'bdp-seo-import-help';
                help.textContent = 'After updating, review products first, then sync selected products to Shofy/Botble.';
                actions.appendChild(help);
            }
        });
    }

    if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', enhanceSeoImportForm);
    } else {
        enhanceSeoImportForm();
    }
})();
</script>

