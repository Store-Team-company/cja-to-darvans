<script id="bdp-import-tabs-ui-js">
(function () {
    function closestBlock(el) {
        return el.closest('.bdp-card, .card, section, article, .bdp-seo-import-clean-card, .bdp-seo-import-panel, div') || el.parentElement;
    }

    function textLooksLike(el, pattern) {
        return el && pattern.test((el.textContent || '').trim());
    }

    function hideNearbyOldHeadings(pattern) {
        Array.prototype.slice.call(document.querySelectorAll('h1,h2,h3,p,.bdp-card,.bdp-seo-import-clean-card,.bdp-seo-import-panel')).forEach(function (el) {
            if (textLooksLike(el, pattern) && !el.closest('.bdp-import-tabs-shell')) {
                var block = el.closest('.bdp-seo-import-clean-card, .bdp-seo-import-panel, .bdp-card, section') || el;
                block.setAttribute('data-bdp-import-tab-hidden', '1');
            }
        });
    }

    function initImportTabs() {
        if (document.querySelector('.bdp-import-tabs-shell')) return;

        var forms = Array.prototype.slice.call(document.querySelectorAll('form'));

        var seoForm = forms.find(function (form) {
            var action = form.getAttribute('action') || '';
            return action.indexOf('bulk-optimization/import') !== -1;
        });

        var productForm = forms.find(function (form) {
            if (form === seoForm) return false;
            var hasFile = !!form.querySelector('input[type="file"]');
            var hasImportSource = !!form.querySelector('select[name*="source"], select[name*="import"], select');
            var action = form.getAttribute('action') || '';
            return hasFile && (hasImportSource || action.indexOf('import') !== -1);
        });

        if (!seoForm && !productForm) return;

        var insertTarget = (productForm && closestBlock(productForm)) || (seoForm && closestBlock(seoForm)) || document.querySelector('main') || document.body;

        var shell = document.createElement('div');
        shell.className = 'bdp-import-tabs-shell';

        shell.innerHTML =
            '<div class="bdp-import-tabs-nav">' +
                '<button type="button" class="bdp-import-tab-btn is-active" data-bdp-import-tab="seo">Update Products from SEO CSV</button>' +
                '<button type="button" class="bdp-import-tab-btn" data-bdp-import-tab="products">Import Products</button>' +
            '</div>' +
            '<div class="bdp-import-tabs-body">' +
                '<div class="bdp-import-tab-panel is-active" data-bdp-import-panel="seo">' +
                    '<h2>Update Products from SEO CSV</h2>' +
                    '<p class="bdp-tab-help">Update existing Data Pilot products after bulk SEO optimization.</p>' +
                    '<div class="bdp-import-tab-note"><strong>Match:</strong> product_id first. SKU can be updated. Do not change row_type or product_id.</div>' +
                '</div>' +
                '<div class="bdp-import-tab-panel" data-bdp-import-panel="products">' +
                    '<h2>Import Products</h2>' +
                    '<p class="bdp-tab-help">Upload WooCommerce or CJA product CSV/Excel files.</p>' +
                '</div>' +
            '</div>';

        insertTarget.parentNode.insertBefore(shell, insertTarget);

        var seoPanel = shell.querySelector('[data-bdp-import-panel="seo"]');
        var productPanel = shell.querySelector('[data-bdp-import-panel="products"]');

        if (seoForm) {
            seoPanel.appendChild(seoForm);

            var checkbox = seoForm.querySelector('input[name="update_products"]');
            if (checkbox && !checkbox.closest('.bdp-seo-confirm-row')) {
                var row = document.createElement('label');
                row.className = 'bdp-seo-confirm-row';
                checkbox.parentNode.insertBefore(row, checkbox);
                row.appendChild(checkbox);
                row.appendChild(document.createTextNode(' Yes, update existing products'));
            }

            var file = seoForm.querySelector('input[type="file"]');
            if (file && !file.previousElementSibling) {
                var label = document.createElement('label');
                label.textContent = 'Optimized SEO CSV File';
                file.parentNode.insertBefore(label, file);
            }
        } else {
            seoPanel.insertAdjacentHTML('beforeend', '<div class="bdp-import-tab-note">SEO CSV import form was not found.</div>');
        }

        if (productForm) {
            productPanel.appendChild(productForm);

            var productNotes = Array.prototype.slice.call(document.querySelectorAll('h3,p')).filter(function (el) {
                return /CJA Excel Import Notes|embedded variation images|Parent product images/i.test(el.textContent || '');
            });

            if (productNotes.length) {
                var notes = document.createElement('div');
                notes.className = 'bdp-import-tab-note';
                notes.innerHTML = '<strong>Note:</strong> CJA imports can read product title, SKU, specification, inventory, cost, and variation images.';
                productPanel.appendChild(notes);
            }
        } else {
            productPanel.insertAdjacentHTML('beforeend', '<div class="bdp-import-tab-note">Product import form was not found.</div>');
        }

        // Hide old blocks/headings left behind by earlier patches.
        hideNearbyOldHeadings(/Update Products from SEO CSV|Update Products from Optimized SEO CSV/i);
        hideNearbyOldHeadings(/Import Products/i);
        Array.prototype.slice.call(document.querySelectorAll('h3,p')).forEach(function (el) {
            if (/CJA Excel Import Notes|embedded variation images|Parent product images/i.test(el.textContent || '') && !el.closest('.bdp-import-tabs-shell')) {
                el.setAttribute('data-bdp-import-tab-hidden', '1');
            }
        });

        shell.querySelectorAll('.bdp-import-tab-btn').forEach(function (btn) {
            btn.addEventListener('click', function () {
                var tab = btn.getAttribute('data-bdp-import-tab');

                shell.querySelectorAll('.bdp-import-tab-btn').forEach(function (b) {
                    b.classList.toggle('is-active', b === btn);
                });

                shell.querySelectorAll('.bdp-import-tab-panel').forEach(function (panel) {
                    panel.classList.toggle('is-active', panel.getAttribute('data-bdp-import-panel') === tab);
                });
            });
        });
    }

    if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', initImportTabs);
    } else {
        initImportTabs();
    }
})();
</script>

