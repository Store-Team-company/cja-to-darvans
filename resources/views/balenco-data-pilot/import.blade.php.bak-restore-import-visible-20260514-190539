<script id="bdp-import-clean-ui-js">
(function () {
    function findSeoImportForms() {
        return Array.prototype.slice.call(document.querySelectorAll('form')).filter(function (form) {
            var action = form.getAttribute('action') || '';
            return action.indexOf('bulk-optimization/import') !== -1;
        });
    }

    function cleanImportsUi() {
        var forms = findSeoImportForms();
        if (!forms.length) return;

        // Keep first SEO form only, hide duplicates.
        forms.forEach(function (form, index) {
            if (index > 0) {
                var parent = form.closest('.bdp-card, .bdp-seo-import-panel, .bdp-seo-import-clean-card, section, div') || form;
                parent.setAttribute('data-bdp-old-seo-import', '1');
                return;
            }

            if (form.closest('.bdp-seo-import-clean-card')) return;

            var oldWrap = form.parentElement;

            // Mark old visible text blocks close to this form as hidden if they are duplicate wrappers.
            if (oldWrap && oldWrap !== document.body) {
                oldWrap.setAttribute('data-bdp-old-seo-import', '1');
            }

            var card = document.createElement('div');
            card.className = 'bdp-seo-import-clean-card';

            var head = document.createElement('div');
            head.className = 'bdp-seo-import-clean-head';
            head.innerHTML =
                '<div><h2>Update Products from SEO CSV</h2><p>Matches by product ID. SKU can be updated.</p></div>' +
                '<a class="bdp-btn light" href="' + window.location.origin + '/products">Back to Products</a>';

            var note = document.createElement('div');
            note.className = 'bdp-seo-import-clean-note';
            note.innerHTML = '<strong>Safe rule:</strong> Do not change <strong>row_type</strong> or <strong>product_id</strong>.';

            var insertBefore = oldWrap || form;
            insertBefore.parentNode.insertBefore(card, insertBefore);
            card.appendChild(head);
            card.appendChild(note);

            form.classList.add('bdp-seo-import-clean-form');
            card.appendChild(form);

            var file = form.querySelector('input[type="file"]');
            if (file && !file.closest('[data-bdp-file-wrap]')) {
                var fileWrap = document.createElement('div');
                fileWrap.setAttribute('data-bdp-file-wrap', '1');
                file.parentNode.insertBefore(fileWrap, file);
                fileWrap.innerHTML = '<label>Optimized SEO CSV</label>';
                fileWrap.appendChild(file);
            }

            var check = form.querySelector('input[name="update_products"]');
            if (check && !check.closest('.bdp-seo-import-clean-confirm')) {
                var confirm = document.createElement('label');
                confirm.className = 'bdp-seo-import-clean-confirm';
                check.parentNode.insertBefore(confirm, check);
                confirm.appendChild(check);
                confirm.appendChild(document.createTextNode(' Yes, update existing products'));
            }

            var submit = form.querySelector('button[type="submit"], input[type="submit"]');
            if (submit && !submit.closest('.bdp-seo-import-clean-actions')) {
                var actions = document.createElement('div');
                actions.className = 'bdp-seo-import-clean-actions';
                submit.parentNode.insertBefore(actions, submit);
                actions.appendChild(submit);
            }
        });

        // Hide duplicate headings/text blocks that previous patches left above the real import page.
        Array.prototype.slice.call(document.querySelectorAll('h1, h2, h3')).forEach(function (h) {
            if (/Update Products from Optimized SEO CSV/i.test(h.textContent || '')) {
                var card = h.closest('.bdp-seo-import-clean-card');
                if (!card) {
                    var wrap = h.closest('.bdp-card, section, div');
                    if (wrap && !wrap.querySelector('.bdp-seo-import-clean-card')) {
                        wrap.setAttribute('data-bdp-old-seo-import', '1');
                    }
                }
            }
        });
    }

    if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', cleanImportsUi);
    } else {
        cleanImportsUi();
    }
})();
</script>



