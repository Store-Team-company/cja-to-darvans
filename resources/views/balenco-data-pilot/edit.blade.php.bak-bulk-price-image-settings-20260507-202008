    $variations = $product->variations ?? collect();
    $totalInventory = $variations->sum('quantity');
    $inStockCount = $variations->where('stock_status', 'in_stock')->count();
    $variationColors = $variations->pluck('color')->filter()->unique()->values();
    $productShippingDetails = $product->cj_shipping_details ? json_decode($product->cj_shipping_details, true) : [];
    $mainImage = old('featured_image', $product->featured_image) ?: ($variations->pluck('image')->filter()->first());
    $galleryImages = collect(explode(',', (string) old('gallery_images', $product->gallery_images)))->map(fn($i) => trim($i))->filter()->values();
    $isSynced = !empty($product->balenco_product_id) || !empty($product->shofy_product_id) || in_array($product->balenco_sync_status, ['synced', 'updated'], true);
    $syncStatus = $product->balenco_sync_status ?: ($isSynced ? 'synced' : 'not_synced');
    $seoChecks = [
        'Title' => filled($product->name),
        'Slug' => filled($product->slug),
        'Short description' => filled($product->short_description),
        'Long description' => filled($product->content),
        'SEO title' => filled($product->seo_title),
        'SEO description' => filled($product->seo_description),
        'Category' => filled($product->categories),
        'Final price' => $product->price !== null,
        'Variation images' => $variations->count() === 0 ? false : $variations->whereNotNull('image')->count() > 0,
        'Stock' => $totalInventory > 0,
    ];
    $readyCount = collect($seoChecks)->filter()->count();
    $readyPercent = count($seoChecks) ? round(($readyCount / count($seoChecks)) * 100) : 0;
