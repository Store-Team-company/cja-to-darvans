@php
    use Illuminate\Support\Facades\Route;

    /**
     * Safe setting reader.
     * Works with:
     * - $settings array
     * - Laravel collection
     * - object properties
     * - App\Models\BdpSetting::getValue/setValue style storage
     */
    $bdpGetSetting = function ($keys, $default = '') use ($settings ?? null) {
        $keys = is_array($keys) ? $keys : [$keys];

        foreach ($keys as $key) {
            $old = old($key, null);
            if ($old !== null) {
                return $old;
            }
        }

        foreach ($keys as $key) {
            try {
                if (class_exists(\App\Models\BdpSetting::class)) {
                    if (method_exists(\App\Models\BdpSetting::class, 'getValue')) {
                        $value = \App\Models\BdpSetting::getValue($key, null);
                        if ($value !== null && $value !== '') return $value;
                    }
                    if (method_exists(\App\Models\BdpSetting::class, 'get')) {
                        $value = \App\Models\BdpSetting::get($key, null);
                        if ($value !== null && $value !== '') return $value;
                    }
                    try {
                        $row = \App\Models\BdpSetting::query()->where('key', $key)->first();
                        if ($row && isset($row->value) && $row->value !== '') return $row->value;
                    } catch (\Throwable $e) {}
                }
            } catch (\Throwable $e) {}
        }

        foreach ($keys as $key) {
            try {
                if (is_array($settings) && array_key_exists($key, $settings) && $settings[$key] !== '') {
                    return $settings[$key];
                }

                if ($settings instanceof \Illuminate\Support\Collection) {
                    $value = $settings->get($key);
                    if ($value !== null && $value !== '') return $value;

                    $row = $settings->first(function ($item) use ($key) {
                        return (is_array($item) && ($item['key'] ?? null) === $key)
                            || (is_object($item) && ($item->key ?? null) === $key);
                    });

                    if (is_array($row) && isset($row['value']) && $row['value'] !== '') return $row['value'];
                    if (is_object($row) && isset($row->value) && $row->value !== '') return $row->value;
                }

                if (is_object($settings) && isset($settings->{$key}) && $settings->{$key} !== '') {
                    return $settings->{$key};
                }
            } catch (\Throwable $e) {}
        }

        return $default;
    };

    $bdpSettingsSaveUrl = Route::has('bdp.settings.save')
        ? route('bdp.settings.save')
        : (Route::has('bdp.settings.update') ? route('bdp.settings.update') : url('/settings'));

    $bdpConnectedStoreSaveUrl = Route::has('bdp.settings.connected-store.save')
        ? route('bdp.settings.connected-store.save')
        : $bdpSettingsSaveUrl;

    $bdpTestConnectionUrl = Route::has('bdp.settings.test-connection')
        ? route('bdp.settings.test-connection')
        : (Route::has('bdp.settings.test-store') ? route('bdp.settings.test-store') : $bdpSettingsSaveUrl);

    $bdpStorePushMethod = $bdpGetSetting(['store_push_method', 'push_method'], 'database');
    $bdpStoreDomain = $bdpGetSetting(['store_domain', 'connected_store_domain'], '');
    $bdpStoreDbPasswordSaved = $bdpGetSetting(['store_db_password', 'connected_store_db_password', 'db_password'], '') !== '';
    $bdpStoreApiSecretSaved = $bdpGetSetting(['store_api_secret', 'connected_store_api_secret', 'api_secret'], '') !== '';
