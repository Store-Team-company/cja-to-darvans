APP_NAME="Balenco Data Pilot"
APP_ENV=production
APP_KEY=base64:GENERATE_WITH_PHP_ARTISAN_KEY_GENERATE
APP_DEBUG=false
APP_URL=https://your-data-pilot-domain.com

LOG_CHANNEL=stack
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=YOUR_DATA_PILOT_DB
DB_USERNAME=YOUR_DATA_PILOT_DB_USER
DB_PASSWORD=YOUR_DATA_PILOT_DB_PASSWORD

CACHE_DRIVER=file
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync
SESSION_DRIVER=file
SESSION_LIFETIME=120

BDP_LOGIN_USERNAME=admin
BDP_LOGIN_PASSWORD=CHANGE_THIS_PASSWORD
BDP_DEFAULT_VARIATION_QUANTITY=100

# Shofy/Botble direct DB connection
SHOFY_DB_HOST=127.0.0.1
SHOFY_DB_PORT=3306
SHOFY_DB_DATABASE=YOUR_SHOFY_DB
SHOFY_DB_USERNAME=YOUR_SHOFY_DB_USER
SHOFY_DB_PASSWORD=YOUR_SHOFY_DB_PASSWORD
SHOFY_CREATED_BY_ID=1
SHOFY_COLOR_ATTRIBUTE_SET_ID=1
SHOFY_SIZE_ATTRIBUTE_SET_ID=2
SHOFY_UPDATE_EXISTING_BY_SKU=true

# Sync defaults
BDP_SYNC_DEFAULT_STATUS=draft

# Variation image copy through Shofy bridge
BDP_COPY_VARIATION_IMAGES_TO_SHOFY=true
SHOFY_IMAGE_UPLOAD_URL=https://your-shofy-domain.com/balenco-data-pilot/upload-image
SHOFY_IMAGE_UPLOAD_TOKEN=CHANGE_THIS_SHARED_SECRET
SHOFY_VARIATION_IMAGE_SUBDIR=products

# WooCommerce-style CJA fallback keys
BDP_WC_CONSUMER_KEY=ck_balenco_data_pilot
BDP_WC_CONSUMER_SECRET=cs_balenco_data_pilot

# Optional CJ API key is stored from the UI/settings in the app database.
# Do not commit real secrets.
