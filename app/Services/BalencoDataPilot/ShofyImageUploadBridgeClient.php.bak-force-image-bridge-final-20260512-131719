<?php

namespace App\Services\BalencoDataPilot;

use Illuminate\Support\Facades\Http;
use Illuminate\Support\Str;
use Throwable;

class ShofyImageUploadBridgeClient
{
    public function uploadRemoteImage(string $imageUrl, string $productName = 'data-pilot-product', string $color = ''): array
    {
        $endpoint = trim((string) env('SHOFY_IMAGE_UPLOAD_URL', ''));
        $token = trim((string) env('SHOFY_IMAGE_UPLOAD_TOKEN', ''));

        if ($endpoint === '' || $token === '') {
            return [
                'success' => false,
                'message' => 'SHOFY_IMAGE_UPLOAD_URL or SHOFY_IMAGE_UPLOAD_TOKEN is missing in Data Pilot .env.',
            ];
        }

        try {
            $response = Http::timeout(60)
                ->retry(2, 700)
                ->withHeaders([
                    'Accept' => 'application/json',
                    'Content-Type' => 'application/json',
                    'X-Data-Pilot-Token' => $token,
                    'X-Data-Pilot-Secret' => $token,
                    'Authorization' => 'Bearer ' . $token,
                    'User-Agent' => 'DataPilotImageBridge/1.0',
                ])
                ->post($endpoint, [
                    'image_url' => $imageUrl,
                    'url' => $imageUrl,
                    'product_name' => $productName,
                    'name' => $productName,
                    'color' => $color,
                    'folder' => trim((string) env('SHOFY_VARIATION_IMAGE_SUBDIR', 'products'), '/'),
                    'filename_prefix' => Str::slug(trim($productName . ' ' . $color) ?: 'data-pilot-image'),
                ]);

            $json = $response->json();

            if (!$response->successful()) {
                return [
                    'success' => false,
                    'message' => 'Image receiver HTTP ' . $response->status() . ': ' . substr($response->body(), 0, 500),
                ];
            }

            if (!is_array($json)) {
                return [
                    'success' => false,
                    'message' => 'Image receiver did not return valid JSON: ' . substr($response->body(), 0, 500),
                ];
            }

            return $json;
        } catch (Throwable $e) {
            return [
                'success' => false,
                'message' => 'Image receiver request failed: ' . $e->getMessage(),
            ];
        }
    }
}
