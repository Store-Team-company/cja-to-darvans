    /**
     * Test the connected store push connection.
     * Supports Direct Database and API Receiver methods.
     */
    public function testConnection(\Illuminate\Http\Request $request)
    {
        // BDP_TEST_PLACEHOLDER_PASSWORD_GUARD: use saved password when the field contains stars.
        if (in_array($request->input('store_db_password'), ['********', '••••••••'], true)) {
            try {
                $savedPassword = null;
                if (class_exists(\App\Models\BdpSetting::class)) {
                    $savedPassword = \App\Models\BdpSetting::where('key', 'store_db_password')->value('value');
                }
                if ($savedPassword) {
                    $request->merge(['store_db_password' => $savedPassword]);
                }
            } catch (\Throwable $e) {}
        }
        if (in_array($request->input('store_api_secret'), ['********', '••••••••'], true)) {
            try {
                $savedSecret = null;
                if (class_exists(\App\Models\BdpSetting::class)) {
                    $savedSecret = \App\Models\BdpSetting::where('key', 'store_api_secret')->value('value');
                }
                if ($savedSecret) {
                    $request->merge(['store_api_secret' => $savedSecret]);
                }
            } catch (\Throwable $e) {}
        }

        $method = $request->input('store_push_method')
            ?: $request->input('push_method')
            ?: $request->input('connected_store_push_method')
            ?: 'database';

        if ($method === 'direct_database') {
            $method = 'database';
        }

        if ($method === 'api_receiver') {
            $method = 'api';
        }

        if ($method === 'database') {
            $host = trim((string) ($request->input('store_db_host')
                ?: $request->input('connected_store_db_host')
                ?: $request->input('db_host')
                ?: ''));

            $port = trim((string) ($request->input('store_db_port')
                ?: $request->input('connected_store_db_port')
                ?: $request->input('db_port')
                ?: '3306'));

            $database = trim((string) ($request->input('store_db_database')
                ?: $request->input('store_db_name')
                ?: $request->input('connected_store_db_database')
                ?: $request->input('connected_store_db_name')
                ?: $request->input('db_database')
                ?: $request->input('db_name')
                ?: ''));

            $username = trim((string) ($request->input('store_db_username')
                ?: $request->input('connected_store_db_username')
                ?: $request->input('db_username')
                ?: ''));

            $password = (string) ($request->input('store_db_password')
                ?: $request->input('connected_store_db_password')
                ?: $request->input('db_password')
                ?: '');

            $prefix = (string) ($request->input('store_db_prefix')
                ?: $request->input('connected_store_db_prefix')
                ?: $request->input('db_prefix')
                ?: '');

            // If password is intentionally left blank on the form, try saved setting keys.
            if ($password === '' && class_exists(\App\Models\BdpSetting::class) && method_exists(\App\Models\BdpSetting::class, 'getValue')) {
                foreach (['store_db_password', 'connected_store_db_password', 'db_password'] as $key) {
                    $saved = \App\Models\BdpSetting::getValue($key, null);
                    if (!empty($saved)) {
                        $password = (string) $saved;
                        break;
                    }
                }
            }

            if ($host === '' || $database === '' || $username === '' || $password === '') {
                return back()->withInput()->with('error', 'Please enter database host, database name, database username, and database password before testing the database connection.');
            }

            $connectionName = 'bdp_target_store_test';

            try {
                config([
                    "database.connections.$connectionName" => [
                        'driver' => 'mysql',
                        'host' => $host,
                        'port' => $port ?: 3306,
                        'database' => $database,
                        'username' => $username,
                        'password' => $password,
                        'unix_socket' => '',
                        'charset' => 'utf8mb4',
                        'collation' => 'utf8mb4_unicode_ci',
                        'prefix' => $prefix,
                        'prefix_indexes' => true,
                        'strict' => false,
                        'engine' => null,
                        'options' => extension_loaded('pdo_mysql') ? array_filter([
                            \PDO::ATTR_TIMEOUT => 10,
                        ]) : [],
                    ],
                ]);

                \Illuminate\Support\Facades\DB::purge($connectionName);
                \Illuminate\Support\Facades\DB::connection($connectionName)->getPdo();

                $productsTable = $prefix . 'ec_products';
                $hasProductsTable = \Illuminate\Support\Facades\Schema::connection($connectionName)->hasTable($productsTable);

                if (!$hasProductsTable) {
                    return back()->withInput()->with('error', "Database connected, but Botble table {$productsTable} was not found. Check database name or table prefix.");
                }

                return back()->withInput()->with('success', 'Database connected successfully. Botble ecommerce table ec_products was detected.');
            } catch (\Throwable $e) {
                return back()->withInput()->with('error', 'Database connection failed: ' . $e->getMessage());
            }
        }

        if ($method === 'api') {
            $endpoint = trim((string) ($request->input('store_api_url')
                ?: $request->input('store_api_base_url')
                ?: $request->input('store_admin_api_url')
                ?: $request->input('connected_store_api_url')
                ?: ''));

            $secret = (string) ($request->input('store_api_secret')
                ?: $request->input('connected_store_api_secret')
                ?: $request->input('api_secret')
                ?: '');

            if ($endpoint === '' || $secret === '') {
                return back()->withInput()->with('error', 'Please enter API endpoint URL and API secret key before testing the API connection.');
            }

            try {
                $response = \Illuminate\Support\Facades\Http::withHeaders([
                    'X-Data-Pilot-Secret' => $secret,
                    'Accept' => 'application/json',
                ])->timeout(15)->get(rtrim($endpoint, '/') . '/data-pilot/ping');

                if ($response->successful()) {
                    return back()->withInput()->with('success', 'API receiver connected successfully.');
                }

                return back()->withInput()->with('error', 'API receiver responded with status: ' . $response->status());
            } catch (\Throwable $e) {
                return back()->withInput()->with('error', 'API connection failed: ' . $e->getMessage());
            }
        }

        return back()->withInput()->with('error', 'Invalid push method selected.');
    }



    /**
     * Save Connected Store settings after a successful test connection.
     * This saves the current values from the Connected Store tab so product sync can use them later.
     */
    public function saveConnectedStore(\Illuminate\Http\Request $request)
    {
        // BDP_PLACEHOLDER_PASSWORD_GUARD: keep saved secrets when UI sends stars.
        foreach (['store_db_password', 'store_api_secret', 'store_api_secret_key'] as $secretField) {
            $secretValue = $request->input($secretField);
            if (in_array($secretValue, ['********', '••••••••'], true)) {
                $request->request->remove($secretField);
            }
        }

        $pick = function (array $names, $default = null) use ($request) {
            foreach ($names as $name) {
                $value = $request->input($name);
                if ($value !== null && $value !== '') {
                    return $value;
                }
            }
            return $default;
        };

        $setSetting = function (string $key, $value) {
            if ($value === null) {
                $value = '';
            }

            if (! class_exists(\App\Models\BdpSetting::class)) {
                return;
            }

            if (method_exists(\App\Models\BdpSetting::class, 'setValue')) {
                \App\Models\BdpSetting::setValue($key, $value);
                return;
            }

            if (method_exists(\App\Models\BdpSetting::class, 'set')) {
                \App\Models\BdpSetting::set($key, $value);
                return;
            }

            \App\Models\BdpSetting::updateOrCreate(['key' => $key], ['value' => $value]);
        };

        $values = [
            'store_name' => $pick(['store_name', 'connected_store_name'], 'Connected Store'),
            'store_domain' => $pick(['store_domain', 'connected_store_domain', 'domain']),
            'store_admin_api_url' => $pick(['store_admin_api_url', 'store_api_url', 'store_api_base_url', 'api_base_url']),
            'store_status' => $pick(['store_status'], 'enabled'),
            'store_push_method' => $pick(['store_push_method', 'push_method'], 'database'),

            // Direct database connection settings.
            'store_db_host' => $pick(['store_db_host', 'database_host', 'db_host']),
            'store_db_port' => $pick(['store_db_port', 'database_port', 'db_port'], '3306'),
            'store_db_database' => $pick(['store_db_database', 'store_database_name', 'database_name', 'db_database', 'db_name']),
            'store_db_username' => $pick(['store_db_username', 'database_username', 'db_username', 'db_user']),
            'store_db_prefix' => $pick(['store_db_prefix', 'database_prefix', 'db_prefix', 'table_prefix']),

            // API receiver settings.
            'store_api_receiver_url' => $pick(['store_api_receiver_url', 'api_receiver_url', 'receiver_url']),
        ];

        foreach ($values as $key => $value) {
            $setSetting($key, $value);
        }

        // Passwords/secrets are only overwritten when user enters a new value.
        $dbPassword = $pick(['store_db_password', 'database_password', 'db_password']);
        if ($dbPassword !== null && $dbPassword !== '') {
            $setSetting('store_db_password', $dbPassword);
        }

        $apiSecret = $pick(['store_api_secret', 'api_secret', 'receiver_secret']);
        if ($apiSecret !== null && $apiSecret !== '') {
            $setSetting('store_api_secret', $apiSecret);
        }

        $setSetting('store_connection_saved_at', now()->toDateTimeString());

        return redirect()->route('bdp.settings')->with('success', 'Connected store configuration saved successfully.');
    }

