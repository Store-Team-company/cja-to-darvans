            return redirect()->route('bdp.products.edit', $product)->with('success', $message);
        } catch (\Throwable $e) {
            return redirect()->route('bdp.products.edit', $product)->with('error', 'CJ inventory/shipping refresh failed: ' . $e->getMessage());
        }
    }

