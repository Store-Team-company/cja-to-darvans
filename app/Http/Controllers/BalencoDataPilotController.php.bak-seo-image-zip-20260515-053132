    /**
     * Download only parent/featured + gallery images for manual Balenco upload.
     * This intentionally excludes variation/size/color image rows.
     * If featured/gallery fields are empty, it tries to recover parent gallery images
     * from the stored CJ/raw JSON payload, but still skips variation-like arrays.
     */
    public function downloadProductImagesZip($product)
    {
        if (!$product instanceof \Illuminate\Database\Eloquent\Model) {
            $product = \App\Models\BdpProduct::query()->findOrFail($product);
        }

        if (!class_exists(\ZipArchive::class)) {
            return back()->with('error', 'PHP ZipArchive extension is not enabled. Please enable the PHP zip extension.');
        }

        $imageUrls = [];
        $addUrl = function ($url) use (&$imageUrls) {
            if (!is_string($url)) {
                return;
            }

            $url = trim($url, " \t\n\r\0\x0B\"'");
            if ($url === '') {
                return;
            }

            if (str_starts_with($url, '//')) {
                $url = 'https:' . $url;
            }

            if (!preg_match('#^https?://#i', $url)) {
                return;
            }

            $imageUrls[] = $url;
        };

        // 1) Explicit parent featured image.
        $addUrl($product->featured_image ?? null);
        $addUrl($product->image ?? null);

        // 2) Explicit gallery_images field. Supports comma-separated text and JSON arrays.
        $galleryRaw = $product->gallery_images ?? null;
        if (is_string($galleryRaw) && trim($galleryRaw) !== '') {
            $decoded = json_decode($galleryRaw, true);
            if (json_last_error() === JSON_ERROR_NONE && is_array($decoded)) {
                $walker = function ($value) use (&$walker, $addUrl) {
                    if (is_array($value)) {
                        foreach ($value as $child) {
                            $walker($child);
                        }
                    } else {
                        $addUrl($value);
                    }
                };
                $walker($decoded);
            } else {
                foreach (preg_split('/[,\n\r]+/', $galleryRaw) as $part) {
                    $addUrl($part);
                }
            }
        }

        // 3) Recover parent gallery from raw JSON if Data Pilot did not store fields.
        //    We skip keys/paths that look like variants, sizes, SKUs, colors, or inventory.
        $rawCandidates = [
            'raw_json', 'cj_raw_json', 'raw_payload', 'source_json', 'product_json',
            'cj_product_json', 'cj_data', 'source_data', 'payload'
        ];

        $skipPath = function (array $path): bool {
            $joined = strtolower(implode('.', $path));
            return (bool) preg_match('/(variant|variation|variants|variantlist|sku|skus|sell|size|color|inventory|stock|warehouse|stan|standard)/i', $joined);
        };

        $looksImageKey = function ($key): bool {
            $key = strtolower((string) $key);
            return (bool) preg_match('/(image|images|img|pic|picture|productimage|productimages|mainimage|gallery)/i', $key);
        };

        $walkRaw = function ($value, array $path = []) use (&$walkRaw, $addUrl, $skipPath, $looksImageKey) {
            if ($skipPath($path)) {
                return;
            }

            if (is_array($value)) {
                foreach ($value as $key => $child) {
                    $newPath = array_merge($path, [(string) $key]);
                    if (is_string($child) && $looksImageKey($key)) {
                        foreach (preg_split('/[,\n\r]+/', $child) as $part) {
                            $addUrl($part);
                        }
                    } else {
                        $walkRaw($child, $newPath);
                    }
                }
                return;
            }

            if (is_string($value) && preg_match('#https?://[^\s\"\']+\.(?:jpg|jpeg|png|webp|gif)(?:\?[^\s\"\']*)?#i', $value)) {
                $lastKey = end($path);
                if ($looksImageKey($lastKey)) {
                    foreach (preg_split('/[,\n\r]+/', $value) as $part) {
                        $addUrl($part);
                    }
                }
            }
        };

        foreach ($rawCandidates as $column) {
            if (!isset($product->{$column}) || empty($product->{$column})) {
                continue;
            }
            $decoded = is_array($product->{$column}) ? $product->{$column} : json_decode((string) $product->{$column}, true);
            if (json_last_error() === JSON_ERROR_NONE && is_array($decoded)) {
                $walkRaw($decoded, [$column]);
            }
        }

        $imageUrls = collect($imageUrls)
            ->filter()
            ->map(fn ($url) => trim((string) $url))
            ->unique()
            ->values()
            ->take(30);

        if ($imageUrls->isEmpty()) {
            return back()->with('error', 'No parent featured or gallery images were found for this product. This product may only have variation/color images saved. Open the product in CJ/Balenco and upload the parent gallery manually, or enable parent gallery saving on import.');
        }

        $slug = \Illuminate\Support\Str::slug($product->slug ?: $product->name ?: ('product-' . $product->id));
        if (!$slug) {
            $slug = 'product-' . $product->id;
        }

        $tmpZip = tempnam(sys_get_temp_dir(), 'bdp-parent-gallery-zip-');
        $zip = new \ZipArchive();
        if ($zip->open($tmpZip, \ZipArchive::OVERWRITE) !== true) {
            return back()->with('error', 'Could not create ZIP file.');
        }

        $failed = [];
        $added = 0;

        foreach ($imageUrls as $index => $url) {
            try {
                $response = \Illuminate\Support\Facades\Http::timeout(25)
                    ->retry(1, 300)
                    ->withHeaders(['User-Agent' => 'Balenco Data Pilot Image Downloader'])
                    ->get($url);

                if (!$response->successful() || strlen($response->body()) < 100) {
                    $failed[] = $url;
                    continue;
                }

                $contentType = strtolower((string) $response->header('content-type'));
                $pathExt = strtolower(pathinfo(parse_url($url, PHP_URL_PATH) ?: '', PATHINFO_EXTENSION));
                $ext = in_array($pathExt, ['jpg', 'jpeg', 'png', 'webp', 'gif'], true) ? $pathExt : null;
                if (!$ext) {
                    $ext = str_contains($contentType, 'png') ? 'png' : (str_contains($contentType, 'webp') ? 'webp' : (str_contains($contentType, 'gif') ? 'gif' : 'jpg'));
                }

                $filename = $index === 0
                    ? 'featured-image.' . $ext
                    : 'gallery-' . str_pad((string) $index, 2, '0', STR_PAD_LEFT) . '.' . $ext;

                $zip->addFromString($filename, $response->body());
                $added++;
            } catch (\Throwable $e) {
                $failed[] = $url;
            }
        }

        if ($failed) {
            $zip->addFromString('download-failed-urls.txt', implode(PHP_EOL, $failed));
        }

        $zip->close();

        if ($added === 0) {
            @unlink($tmpZip);
            return back()->with('error', 'Parent/gallery image URLs were found, but none could be downloaded. Check remote CJ image access or try again later.');
        }

        return response()->download($tmpZip, $slug . '-featured-gallery-images.zip')->deleteFileAfterSend(true);
    }



