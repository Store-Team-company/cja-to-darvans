        $selectedIds = collect((array) $request->input('products', []))
            ->map(fn ($id) => (int) $id)
            ->filter(fn ($id) => $id > 0)
            ->unique()
            ->values();

        $filenamePrefix = $selectedIds->isNotEmpty()
            ? 'data-pilot-selected-seo-content-'
            : 'data-pilot-bulk-seo-content-';

        $filename = $filenamePrefix . now()->format('Y-m-d-His') . '.csv';

        $headers = [
            'row_type',
            'product_id',
            'sku',
